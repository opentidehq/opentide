{
  "name": "opentide",
  "languages": {
    "opentide-yaml": {
      "language_servers": ["opentide-lsp"],
      "path_suffixes": ["yaml", "yml"]
    },
    "kql": {
      "language_servers": ["opentide-lsp"],
      "path_suffixes": ["kql"]
    },
    "spl": {
      "language_servers": ["opentide-lsp"],
      "path_suffixes": ["spl"]
    },
    "esql": {
      "language_servers": ["opentide-lsp"],
      "path_suffixes": ["esql"]
    },
    "eql": {
      "language_servers": ["opentide-lsp"],
      "path_suffixes": ["eql"]
    },
    "kuery": {
      "language_servers": ["opentide-lsp"],
      "path_suffixes": ["kuery"]
    },
    "lucene": {
      "language_servers": ["opentide-lsp"],
      "path_suffixes": ["lucene"]
    }
  },
  "lsp": {
    "opentide-lsp": {
      "command": "opentide-lsp",
      "args": ["--stdio"]
    }
  },
  "notes": "Disable yamlls on objects/**. Copy TextMate from highlights-v*.zip, never hand-author."
}
