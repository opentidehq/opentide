#!/bin/sh
# RUSTC_WRAPPER for ci.yml's `build` job (#1141): sccache, without
# CARGO_PRIMARY_PACKAGE.
#
# sccache keys every compile on each CARGO_* variable, and cargo sets
# CARGO_PRIMARY_PACKAGE only for the packages named on the command line. The
# push's `--workspace` build, which saves the compiler cache, names every
# crate; a pull request names its affected crates, so every other workspace
# crate it compiles missed the cache (measured on a one-line opentide-yara
# change: opentide-schema, 48 s on the critical path). rustc does not read the
# variable; clippy does, and engine-lint does not use this wrapper. No
# workspace crate reads it (pyo3 reads it for its own tests only).
unset CARGO_PRIMARY_PACKAGE
exec sccache "$@"
