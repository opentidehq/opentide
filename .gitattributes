# Golden recordings are bytes, compared exactly: no end-of-line conversion.
# GitHub folds them in diffs (generated); tests/golden/README.md says how to review them.
tests/golden/cases/** -text linguist-generated
tests/golden/blobs/** -text linguist-generated
tests/golden/COVERAGE.md linguist-generated
tests/golden/oracle-requirements.txt linguist-generated
tests/golden/fixtures/** -text
# The golden fixture sources outside tests/golden/fixtures/ (cases.toml's `source`):
# the harnesses lay them out and compare the bytes `--fix` writes with the
# recordings, so a Windows checkout must hold the recorded (LF) bytes too.
tests/fixtures/tide_corpus/** -text
# The MCP sessions' Agent Plugin root (tests/golden/mcp/sessions.toml), laid out the same way.
tests/fixtures/agent_plugin_root/** -text
# The minijinja templates compiled in with include_str! (setup ci's pipelines,
# generate docs' pages) and setup ci's oracle pipelines: files a user commits,
# compared byte for byte, so a Windows checkout holds the LF bytes too.
crates/opentide-compile/src/**/templates/*.j2 -text
crates/opentide-compile/tests/ci/** -text
# The renderers' oracle files (crates/opentide-cli/AGENTS.md): compared byte for byte too.
crates/opentide-cli/tests/render/** -text linguist-generated

# Digested and compiled in byte for byte (data/specifications.lock.json through
# `cargo xtask vocab`, opentide-schema's include_str!): no end-of-line conversion,
# so a Windows checkout holds the bytes specifications publishes.
src/opentide/data/vocabulary/*.vocab.toml -text
src/opentide/data/pins/*.toml -text
src/opentide/data/sentinel/*.json -text
# Generated by `cargo xtask codegen` and compared byte for byte (codegen --check,
# generate::tests): no end-of-line conversion on a Windows checkout.
src/opentide/schemas/data/platform_templates/*.template.yaml -text
# The object templates the language server compiles in as snippets, generated by
# `cargo xtask codegen` and compared with the generator byte for byte
# (crates/opentide-tide/tests/snippets.rs, #814): LF on a Windows checkout too.
data/catalogs/tide/templates/*.template.yaml -text
# The Falco rules the engine's tests edit by search and replace
# (crates/opentide-analysis/tests/falco_rules.rs): the bytes as committed.
crates/testdata/workspaces/falco/** -text
# Test fixtures the language server's tests edit by search and replace
# (crates/opentide-lsp/tests/protocol.rs): the bytes as committed, LF, on a
# Windows checkout too.
crates/testdata/objects/** -text
# The explain pages, compiled into the Rust CLI (crates/opentide-cli/build.rs's
# include_str!) and read by the Python CLI: the bytes as committed, LF, on a
# Windows checkout too.
src/opentide/data/diagnostics/*.md -text

# The language server field catalog opentide-schema generates and compares byte for
# byte with the oracle's (crates/opentide-schema/tests/catalog.rs): the bytes as
# committed, LF, on a Windows checkout too.
data/catalogs/tide/generated/*.json -text
# The agent skills and entrypoint templates `setup skills` writes (compiled into
# the Rust CLI with include_bytes!): the same bytes on every checkout.
src/opentide/data/setup/skills/** -text

# The conformance fixtures of the 0.16.0 engine languages: their tests compare
# byte offsets (highlight goldens, recorded verdicts), so a Windows checkout
# holds the committed LF bytes too.
crates/testdata/conformance/exabeam/** -text
crates/testdata/conformance/yara/** -text
crates/testdata/conformance/yara-x/** -text
crates/testdata/conformance/google-yaral/** -text
crates/testdata/conformance/specifications-google-secops/** -text
crates/testdata/conformance/external/exabeam/** -text
crates/testdata/conformance/external/yara/** -text
crates/testdata/conformance/external/yaral/** -text
crates/testdata/corpus/yara/** -text
crates/testdata/corpus/yaral/** -text
crates/testdata/corpus/exabeam/** -text
crates/testdata/oracles/graylog/** -text
