# Golden recordings are bytes, compared exactly: no end-of-line conversion.
# GitHub folds them in diffs (generated); tests/golden/README.md says how to review them.
tests/golden/cases/** -text linguist-generated
tests/golden/blobs/** -text linguist-generated
tests/golden/COVERAGE.md linguist-generated
tests/golden/oracle-requirements.txt linguist-generated
tests/golden/fixtures/** -text
# The renderers' oracle files (crates/opentide-cli/AGENTS.md): compared byte for byte too.
crates/opentide-cli/tests/render/** -text linguist-generated

# Digested and compiled in byte for byte (data/specifications.lock.json through
# `cargo xtask vocab`, opentide-schema's include_str!): no end-of-line conversion,
# so a Windows checkout holds the bytes specifications publishes.
src/opentide/data/vocabulary/*.vocab.toml -text
src/opentide/data/pins/*.toml -text
src/opentide/data/sentinel/*.json -text
