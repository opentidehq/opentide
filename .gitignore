# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
!scripts/build/
!scripts/build/*.py
!scripts/build/*.md
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
/parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
# cargo output of the crate placeholder (publishing/placeholders/): ignored
# here, where hatchling also reads it, so an sdist built after a dry run
# leaves it out.
publishing/placeholders/crates/*/target/

# Virtual environments
.venv/
.venv-scaffold/
venv/
ENV/
env/

# Unit test / coverage
.cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
pytest-results.xml
codeql-results.sarif
.codeql-db/
*.cover
.hypothesis/

# Type checkers
.ty_cache/
.ruff_cache/

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db


# Local secrets and environment
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# opentide client / detection instance checkouts (injected alongside CoreTide)
*-repo/
*sentinel-repo/
*client-repo/
client-instances/
instances/
local-instance/

# Generated / staging outputs from engines and pipelines
staging/
output/
generated/
*.log

# Hatch-VCS generated version file
src/opentide/_version.py

# workshop
workshop/
# Agent tooling: per-user settings and harness worktrees stay local
.claude/settings.local.json
.claude/worktrees/

# The module an editable install compiles into the package (hatch_build.py).
src/opentide/_native.*.so
src/opentide/_native.pyd
src/opentide/_native.*.pyd
src/opentide/_native.so

# The Cargo workspace (crates/, bindings/python/) and the engine's tooling.
/target
/node_modules
/packages/*/node_modules
/packages/*/dist
# The Node binding's npm packages: their dependencies, and the addons `npm run
# build` and the release copy in (bindings/node/index.js and index.d.ts are
# generated and committed).
/bindings/node/node_modules
/bindings/node/alias/node_modules
/bindings/node/*.node
/bindings/node/npm/*/*.node
/bindings/node/*.tgz
**/*.wasm
grammars/*/build
grammars/*/node_modules
*.profraw
/coverage
lcov.info
/tmp
scripts/engine/oracles/kusto/bin
scripts/engine/oracles/kusto/obj
scripts/engine/oracles/elastic/node_modules
scripts/engine/oracles/elastic/.cache
highlights/test/node_modules

# Generated, and source here: the engine's bundled Tide catalog and the
# highlighting artifacts, which `generated/` above would hide (and keep out of
# the sdist, whose build compiles them in), and their copies in a crate's assets/
# (`scripts/engine/release.py vendor`), which `cargo package` would leave out.
!/data/catalogs/tide/generated/
!/highlights/generated/
!/crates/*/assets/data/catalogs/tide/generated/
!/crates/*/assets/highlights/generated/

# insta writes a pending snapshot next to the committed one; `cargo insta review`
# accepts or rejects it. Never commit one.
*.snap.new
*.pending-snap

# cargo-mutants output (.cargo/mutants.toml)
/mutants.out/
/mutants.out.old/

# The YARA module generator's own build (scripts/engine/yara-modules)
/scripts/engine/yara-modules/target/

# sccache's directory in CI (SCCACHE_DIR, .github/workflows/ci.yml)
.sccache/
