name: Office spawns PowerShell
metadata:
  uuid: 8d7c6b5a-0000-4000-8000-000000000202
  schema: rule::1.0
  version: 1
  created: "2026-01-02"
  modified: "2026-02-03"
  tlp: amber+strict
  author: alice@contoso.example
description: PowerShell started by an Office application.
response:
  alert_severity: High
configurations:
  microsoft_defender:
    schema: platform::microsoft_defender::1.0
    status: DISABLED
    tenants:
      - lab
    query: |
      DeviceProcessEvents
        | where FileName == "powershell.exe"
    schedule:
      frequency: NRT
    alert:
      title: Office spawns PowerShell
    entities:
      hosts:
        - device_id: DeviceId

━━━ ws/Imported/Suspicious PowerShell   encoded  command.yaml · created 0644
name: "Suspicious PowerShell: \"encoded\" command"
metadata:
  uuid: 8d7c6b5a-0000-4000-8000-000000000201
  schema: rule::1.0
  version: 1
  created: "2026-01-02"
  modified: "2026-02-03"
  tlp: amber+strict
  author: alice@contoso.example
description: PowerShell started by an Office application.
response:
  alert_severity: Medium
configurations:
  microsoft_defender:
    schema: platform::microsoft_defender::1.0
    status: PRODUCTION
    tenants:
      - lab
    contributors:
      - bob@contoso.example
    query: |
      DeviceProcessEvents
        | where FileName == "powershell.exe"
    schedule:
      frequency: 1H
      lookback: 4H
    alert:
      title: Encoded PowerShell
      recommendation: |-
        Isolate the device.
          Collect the investigation package.
      techniques:
        - T1059.001
        - T1027
      custom_details:
        CommandLine: ProcessCommandLine
      grouping: single_alert
    entities:
      hosts:
        - device_id: DeviceId
          name: DeviceName
      accounts:
        - upn: AccountUpn
    actions:
      isolate_devices:
        - device_id: DeviceId
          isolation_type: full
    scope:
      device_groups:
        - Tier 0
    incident:
      exclude_from_correlation: true

