name: "Office spawns PowerShell"
#references:
  #public:
    #1: 
  #internal:
    #a: 

metadata:
  uuid: 8d7c6b5a-0000-4000-8000-000000000202
  schema: rule::1.0
  version: 1
  created: 2026-01-02
  modified: 2026-02-03
  tlp: amber+strict
  author: alice@contoso.example
  #contributors:
    #-

description: |
  PowerShell started by an Office application.
  Investigate the parent.
#detection_model: 

response:
  alert_severity: High
  #playbook: https://
  #responders: 
  #procedure:

configurations:
  defender_for_endpoint: 
    schema: platform::defender_for_endpoint::1.0
    status: DISABLED
    #contributors:
      #-
    tenants:
      - "lab"
    #flags:
      #-
    
    scheduling: NRT
    
    alert:
      title: Office spawns PowerShell
      #severity: 
      #recommendation: |
        #Type Here
    
    impacted_entities:
      device: DeviceId
      #mailbox: 
      #user: 
    
    #actions:
    
      #devices:
        #isolate_device: 
        #collect_investigation_package: true
        #run_antivirus_scan: true
        #initiate_investigation: true
        #restrict_app_execution: true
    
      #files:
        #allow_block:
          #action: 
          #column: 
          #groups:
            #selection: 
            #device_groups:
              #-
        #quarantine_file: 
    
    scope:
      selection: All
      #device_groups:
        #-
    
    query: |
      DeviceProcessEvents
      | where FileName == "powershell.exe"
