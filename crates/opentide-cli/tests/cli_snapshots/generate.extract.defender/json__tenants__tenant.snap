name: "Suspicious PowerShell: \"encoded\" command"
#references:
  #public:
    #1: 
  #internal:
    #a: 

metadata:
  uuid: 8d7c6b5a-0000-4000-8000-000000000201
  schema: rule::1.0
  version: 1
  created: 2026-01-02
  modified: 2026-02-03
  tlp: amber+strict
  author: alice@contoso.example
  #contributors:
    #-

description: |
  An encoded command line.
  ---
  Recommended Actions : Isolate the device.
  Collect the investigation package.
#detection_model: 

response:
  alert_severity: Medium
  #playbook: https://
  #responders: 
  #procedure:

configurations:
  defender_for_endpoint: 
    schema: platform::defender_for_endpoint::1.0
    status: PRODUCTION
    contributors:
      - bob@contoso.example
    tenants:
      - "lab"
    #flags:
      #-
    
    scheduling: 1H
    
    alert:
      title: Encoded PowerShell
      techniques:
        - T1059.001
        - T1027
      #severity: 
      recommendation: |
        Isolate the device.
        Collect the investigation package.
    
    impacted_entities:
      device: DeviceId
      #mailbox: 
      user: AccountUpn 
    
    #actions:
    
      #devices:
        #isolate_device: 
        #collect_investigation_package: true
        #run_antivirus_scan: true
        #initiate_investigation: true
        #restrict_app_execution: true
    
      #files:
        #allow_block:
          #action: 
          #column: 
          #groups:
            #selection: 
            #device_groups:
              #-
        #quarantine_file: 
    
    scope:
      selection: All
      #device_groups:
        #-
    
    query: |
      DeviceProcessEvents
      | where FileName == "powershell.exe"
