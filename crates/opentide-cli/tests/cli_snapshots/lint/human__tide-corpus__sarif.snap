              "id": "cql_correlate_placement",
              "name": "CqlCorrelatePlacement",
              "shortDescription": {
                "text": "CQL correlate() stands where its reference forbids: after an aggregate or a source function, inside another function's arguments, or with an aggregate in its queries."
              }
