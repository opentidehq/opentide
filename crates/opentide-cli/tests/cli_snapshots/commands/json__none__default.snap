  "environment": [
    {
      "meaning": "Output mode: agent|human|json|plain",
      "name": "OPENTIDE_OUTPUT"
    },
    {
      "meaning": "1 for debug logging, like --debug",
      "name": "OPENTIDE_DEBUG"
    },
    {
      "meaning": "Any non-empty value turns colour off, like --no-color",
      "name": "NO_COLOR"
    },
    {
      "meaning": "0, false, no or off turns colour off; any other value forces it in human and plain output; NO_COLOR and --no-color win",
      "name": "FORCE_COLOR"
    },
    {
      "meaning": "Any value but 0 forces colour, like FORCE_COLOR=1; FORCE_COLOR wins",
      "name": "CLICOLOR_FORCE"
    },
    {
      "meaning": "0 for one-line JSON, 2 for indented; default: indented on a terminal",
      "name": "OPENTIDE_JSON_INDENT"
    },
    {
      "meaning": "Repository root, like --repo",
      "name": "OPENTIDE_REPO_ROOT"
    },
    {
      "meaning": "Data root, like --data: only --technique completion reads it",
      "name": "OPENTIDE_DATA_ROOT"
    },
    {
      "meaning": "HTTP(S) proxy, like --proxy",
      "name": "OPENTIDE_PROXY"
    },
    {
      "meaning": "Folder whose objects are read, when not the repository root",
      "name": "OPENTIDE_TIDE_WORKSPACE"
    },
    {
      "meaning": "Link scheme in code frames: file|vscode|cursor|none; default vscode in VS Code, else file",
      "name": "OPENTIDE_LINKS"
    },
    {
      "meaning": "1 for one JSON object per log line on stderr",
      "name": "OPENTIDE_LOG_JSON"
    },
    {
      "meaning": "Most threads validate uses: a number or auto",
      "name": "OPENTIDE_VALIDATE_WORKERS"
    },
    {
      "meaning": "Fewest objects before validate runs in parallel",
      "name": "OPENTIDE_VALIDATE_PARALLEL_THRESHOLD"
    },
    {
      "meaning": "Seconds each validate query --live check may take, like --check-timeout",
      "name": "OPENTIDE_QUERY_CHECK_TIMEOUT"
    },
    {
      "meaning": "0 turns terminal progress (OSC 9;4) off; 1 sends it to any terminal; json writes progress events on stderr",
