    "RuleOutcome": {
      "additionalProperties": true,
      "description": "How one rule on one tenant went in a real run (#675).",
      "properties": {
        "action": {
          "anyOf": [
            {
              "enum": [
                "create",
                "update",
                "upsert",
                "disable",
                "delete",
                "unchanged"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The plan's action; an Elastic `upsert` reads `create` or `update` once sent, and a rule the tenant already held reads `unchanged`.",
          "title": "Action"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The platform's own message, with its HTTP status when it has one",
          "title": "Error"
        },
        "id": {
          "description": "The rule's UUID",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why a skipped or not attempted rule was not sent",
          "title": "Reason"
        },
        "seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "How long the rule took; 0 when nothing was sent, null when the platform's engine does not report its rules one at a time",
          "title": "Seconds"
        },
        "status": {
          "description": "deployed: the platform accepted it. failed: it was refused, see error. skipped: the engine chose not to send it, see reason. not_attempted: an earlier rule failed",
          "enum": [
            "deployed",
            "failed",
            "skipped",
            "not_attempted"
          ],
          "title": "Status",
          "type": "string"
        },
        "tenant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when the platform has no tenant configured",
          "title": "Tenant"
        }
      },
      "required": [
        "id",
        "name",
        "platform",
        "tenant",
        "action",
        "status",
        "seconds",
        "error"
      ],
      "title": "RuleOutcome",
      "type": "object"
    },
    "RulePayload": {
      "additionalProperties": true,
