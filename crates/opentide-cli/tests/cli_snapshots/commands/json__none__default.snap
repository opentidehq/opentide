          "title": "Fixable",
          "type": "integer"
        },
        "fixed": {
          "default": 0,
          "description": "With --fix: values replaced",
          "title": "Fixed",
          "type": "integer"
        },
        "objects": {
          "default": 0,
          "description": "Objects checked",
          "title": "Objects",
          "type": "integer"
        },
        "queries": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Queries checked (absent with --queries off)",
          "title": "Queries"
        },
        "warning_files": {
          "default": 0,
          "description": "Files with a warning",
          "title": "Warning Files",
          "type": "integer"
        },
        "warnings": {
          "default": 0,
          "title": "Warnings",
          "type": "integer"
        }
      },
      "title": "ValidateSummary",
      "type": "object"
    },
    "ValidationIssueModel": {
      "additionalProperties": true,
      "description": "A validation issue: the engine's fields plus the diagnostic fields.",
      "properties": {
        "code": {
          "description": "Stable snake_case diagnostic code",
          "title": "Code",
          "type": "string"
        },
        "column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based, Unicode code points",
          "title": "Column"
        },
        "context": {
          "additionalProperties": true,
          "title": "Context",
          "type": "object"
        },
        "end_column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exclusive, on end_line",
          "title": "End Column"
        },
        "end_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based line the span ends on; equal to line for a one-line span",
          "title": "End Line"
        },
        "explain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The opentide explain command for the code",
          "title": "Explain"
        },
        "field_path": {
          "description": "YAML path",
          "items": {
            "type": "string"
          },
          "title": "Field Path",
          "type": "array"
        },
        "file_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absolute path",
          "title": "File Path"
        },
        "fix": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "help": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Help"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based",
          "title": "Line"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "object_type": {
          "title": "Object Type",
          "type": "string"
        },
        "object_uuid": {
          "title": "Object Uuid",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Workspace-relative path",
          "title": "Path"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        },
        "yaml_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "0-based",
          "title": "Yaml Line"
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "object_uuid",
        "object_type",
        "file_path",
        "yaml_line"
      ],
      "title": "ValidationIssueModel",
      "type": "object"
    },
    "ValidationReportModel": {
      "additionalProperties": true,
      "description": "A validation session: its issues, its warnings and its statistics.",
      "properties": {
        "issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssueModel"
          },
          "title": "Issues",
          "type": "array"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "stats": {
          "additionalProperties": true,
          "title": "Stats",
          "type": "object"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ValidationIssueModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "ok",
        "issues",
        "warnings",
        "stats"
      ],
      "title": "ValidationReportModel",
      "type": "object"
    },
    "VocabularyDetail": {
      "additionalProperties": true,
      "description": "``info vocab <name>``: one vocabulary's revisions and pins.",
      "properties": {
        "entries": {
          "description": "Keys the vocabulary defines, removed ones included",
          "title": "Entries",
          "type": "integer"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "latest_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Newest revision the key lifecycle defines (major.minor)",
          "title": "Latest Revision"
        },
        "name": {
          "description": "The vocabulary's field, its file name without .vocab.toml",
          "title": "Name",
          "type": "string"
        },
        "pins": {
          "items": {
            "$ref": "#/$defs/VocabularyPin"
          },
          "title": "Pins",
          "type": "array"
        },
        "removed": {
          "description": "Keys with a removed revision",
          "title": "Removed",
          "type": "integer"
        },
        "revisions": {
          "items": {
            "$ref": "#/$defs/VocabularyRevision"
          },
          "title": "Revisions",
          "type": "array"
        },
        "staged": {
          "description": "Whether keys are authored as <stage>::<key>",
          "title": "Staged",
          "type": "boolean"
        },
        "stages": {
          "items": {
            "type": "string"
          },
          "title": "Stages",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "name",
        "entries",
        "removed",
        "staged"
      ],
      "title": "VocabularyDetail",
      "type": "object"
    },
    "VocabularyOverview": {
      "additionalProperties": true,
      "description": "One vocabulary in ``info vocab``: the counts that need no pin lookup.",
      "properties": {
        "entries": {
          "description": "Keys the vocabulary defines, removed ones included",
          "title": "Entries",
          "type": "integer"
        },
        "latest_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Newest revision the key lifecycle defines (major.minor)",
          "title": "Latest Revision"
        },
        "name": {
          "description": "The vocabulary's field, its file name without .vocab.toml",
          "title": "Name",
          "type": "string"
        },
        "removed": {
          "description": "Keys with a removed revision",
          "title": "Removed",
          "type": "integer"
        },
        "staged": {
          "description": "Whether keys are authored as <stage>::<key>",
          "title": "Staged",
          "type": "boolean"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "name",
        "entries",
        "removed",
        "staged"
      ],
      "title": "VocabularyOverview",
      "type": "object"
    },
    "VocabularyPin": {
      "additionalProperties": true,
      "properties": {
        "admitted": {
          "description": "Keys the pin admits",
          "title": "Admitted",
          "type": "integer"
        },
        "defined": {
          "description": "Whether the key lifecycle defines this revision",
          "title": "Defined",
          "type": "boolean"
        },
        "field": {
          "description": "Dotted path of the pinned field",
          "title": "Field",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "schema": {
          "description": "Object schema id, e.g. rule::1.0",
          "title": "Schema",
          "type": "string"
        },
        "scoped": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether the field is authored <stage>::<key>; null when unknown",
          "title": "Scoped"
        }
      },
      "required": [
        "schema",
        "field",
        "revision",
        "defined",
        "admitted"
      ],
      "title": "VocabularyPin",
      "type": "object"
    },
    "VocabularyRevision": {
      "additionalProperties": true,
      "properties": {
        "admitted": {
          "description": "Keys a pin to this revision admits",
          "title": "Admitted",
          "type": "integer"
        },
        "introduced": {
          "description": "Keys whose version is this revision",
          "title": "Introduced",
          "type": "integer"
        },
        "removed": {
          "description": "Keys whose removed is this revision",
          "title": "Removed",
          "type": "integer"
        },
        "revision": {
          "description": "major.minor",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "introduced",
        "removed",
        "admitted"
      ],
      "title": "VocabularyRevision",
      "type": "object"
    }
  },
  "command": "commands",
  "commands": [
    {
      "arguments": [],
      "deprecated": false,
      "example": "opentide validate",
      "group": true,
      "help": "Validate objects and queries",
      "name": "validate",
      "options": [
        {
          "choices": [
            "id-uniqueness",
            "uuid-format",
            "schema",
            "cve",
            "sharing-config",
            "configuration",
            "queries"
          ],
          "default": null,
          "envvars": [],
          "flags": [
            "--check"
          ],
          "help": "Run one check only: id-uniqueness, uuid-format, schema, cve, sharing-config, configuration, queries",
          "is_flag": false,
          "multiple": false,
          "name": "check",
          "required": false,
          "secondary_flags": [],
          "type": "choice"
        },
        {
          "choices": null,
          "default": null,
          "envvars": [],
          "flags": [
            "--file"
          ],
          "help": "Validate only this file (repeatable)",
          "is_flag": false,
          "multiple": true,
          "name": "file",
          "required": false,
          "secondary_flags": [],
          "type": "string"
        },
        {
          "choices": null,
          "default": null,
          "envvars": [],
          "flags": [
            "--uuid"
          ],
          "help": "Validate only the object with this UUID (repeatable)",
          "is_flag": false,
          "multiple": true,
          "name": "uuid",
          "required": false,
          "secondary_flags": [],
          "type": "string"
        },
        {
          "choices": [
            "rule",
            "threat",
            "objective"
          ],
          "default": null,
          "envvars": [],
          "flags": [
            "--type"
          ],
          "help": "Validate only this type: rule, threat or objective (repeatable)",
          "is_flag": false,
          "multiple": true,
          "name": "object_type",
          "required": false,
          "secondary_flags": [],
          "type": "string"
        },
        {
          "choices": null,
          "default": false,
          "envvars": [],
          "flags": [
            "--strict"
          ],
          "help": "Fail on warnings too",
          "is_flag": true,
          "multiple": false,
          "name": "strict",
          "required": false,
          "secondary_flags": [],
          "type": "boolean"
        },
        {
          "choices": [
            "error",
            "warn",
            "off"
          ],
          "default": null,
          "envvars": [],
          "flags": [
            "--queries"
          ],
          "help": "How a query the platform would reject is reported: error (the default), warn (passes unless --strict) or off (queries are not checked)",
          "is_flag": false,
          "multiple": false,
          "name": "queries",
          "required": false,
          "secondary_flags": [],
          "type": "choice"
        },
        {
          "choices": null,
          "default": false,
          "envvars": [],
          "flags": [
            "--allow-empty"
          ],
          "help": "With --strict: pass a full run that finds no detection objects (the commit hook setup writes passes it)",
          "is_flag": true,
          "multiple": false,
          "name": "allow_empty",
          "required": false,
          "secondary_flags": [],
          "type": "boolean"
        },
        {
          "choices": null,
          "default": false,
          "envvars": [],
          "flags": [
            "--fix"
          ],
          "help": "Apply every safe fix (vocabulary typos), then validate again",
          "is_flag": true,
          "multiple": false,
          "name": "fix",
          "required": false,
          "secondary_flags": [],
          "type": "boolean"
        },
        {
          "choices": null,
          "default": false,
          "envvars": [],
          "flags": [
            "--dry-run"
          ],
          "help": "With --fix: print the edits as a diff and change nothing",
          "is_flag": true,
          "multiple": false,
          "name": "dry_run",
          "required": false,
          "secondary_flags": [],
          "type": "boolean"
        },
        {
          "choices": null,
          "default": false,
          "envvars": [],
          "flags": [
            "--watch"
          ],
          "help": "Validate again each time an object file changes; Ctrl-C stops",
          "is_flag": true,
          "multiple": false,
          "name": "watch",
          "required": false,
          "secondary_flags": [],
          "type": "boolean"
        },
        {
          "choices": [
            "text",
            "sarif",
            "codequality"
          ],
          "default": "text",
          "envvars": [],
          "flags": [
            "--format"
          ],
          "help": "text: code frames. sarif: SARIF 2.1.0 for code scanning. codequality: GitLab Code Quality (Code Climate JSON). A report goes to --output, or to stdout instead of the text",
          "is_flag": false,
          "multiple": false,
          "name": "report_format",
          "required": false,
          "secondary_flags": [],
          "type": "choice"
        },
        {
          "choices": null,
          "default": null,
          "envvars": [],
          "flags": [
            "--output"
          ],
          "help": "Write the --format report to this file and print the usual text output too",
          "is_flag": false,
          "multiple": false,
          "name": "output",
          "required": false,
          "secondary_flags": [],
          "type": "path"
        }
      ],
      "output_schema": {
        "anyOf": [
          {
            "$ref": "#/$defs/ValidateResult"
          },
          {
            "$ref": "#/$defs/CommandError"
          }
        ]
      },
      "path": "validate",
      "runs_alone": true,
      "subcommands": [
        "query"
      ],
      "summary": "Validate objects and queries"
    },
