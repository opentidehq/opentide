    "Platform configuration : Microsoft Defender Template": {
        "prefix": "tide-microsoft_defender",
        "scope": "yaml,opentide-yaml",
        "description": "Microsoft Defender: the platform block for a detection rule's configurations, from the generated template.",
        "body": [
            "",
            "  #enabled: false",
            "  #name: ",
            "  schema: platform::microsoft_defender::1.0",
            "  status: ${1:status}",
            "  #flags:",
            "    #- ",
            "  #tenants:",
            "    #- ",
            "  #contributors:",
            "    #- ",
            "",
            "  # KQL (advanced hunting). A real rule's query returns exactly the columns its",
            "  # entities, actions and custom details name.",
            "  query: |",
            "    ${2:...}",
            "  schedule:",
            "    frequency: 1H",
            "    #lookback: 4H  # beta-only",
            "  #alert:",
            "    #title: ",
            "    #description: ",
            "    #severity: High",
            "    #recommendation: ",
            "    #techniques:",
            "      #- T1059.001",
            "    #custom_details:",
            "      #CommandLine: ProcessCommandLine",
            "    #grouping: single_alert  # beta-only",
            "  #entities:",
            "    #hosts:",
            "      #- device_id: DeviceId",
            "        #name: DeviceName",
            "        #dns_domain: DeviceDnsDomain",
            "        #netbios_name: DeviceNetBiosName",
            "        #nt_domain: DeviceNtDomain",
            "    #accounts:",
            "      #- aad_user_id: AccountObjectId",
            "        #sid: AccountSid",
            "        #upn: AccountUpn",
            "        #upn_suffix: AccountUpnSuffix",
            "        #name: AccountName",
            "        #nt_domain: AccountDomain",
            "        #dns_domain: AccountDnsDomain",
            "    #mailboxes:",
            "      #- primary_address: RecipientEmailAddress",
            "    #files:",
            "      #- name: FileName",
            "        #sha1: SHA1",
            "        #sha256: SHA256",
            "    #processes:",
            "      #- sha1: InitiatingProcessSHA1",
            "        #sha256: InitiatingProcessSHA256",
            "    #ips:",
            "      #- address: RemoteIP",
            "        #scope: RemoteIPType",
            "    #urls:",
            "      #- address: RemoteUrl",
            "    #dns:",
            "      #- domain_name: DnsQuery",
            "        #host_ip_address: LocalIP",
            "        #server_ip: DnsServerIP",
            "    #registry_values:",
            "      #- key: RegistryKey",
            "        #value_name: RegistryValueName",
            "    #mail_messages:",
            "      #- network_message_id: NetworkMessageId",
            "        #recipient: RecipientEmailAddress",
            "        #sender: SenderFromAddress",
            "        #subject: Subject",
            "    #mail_clusters:",
            "      #- query: MailClusterQuery",
            "        #source: MailClusterSource",
            "    #cloud_applications:",
            "      #- app_id: ApplicationId",
            "        #name: Application",
            "    #oauth_applications:",
            "      #- oauth_app_id: OAuthApplicationId",
            "    #security_groups:",
            "      #- object_id: GroupObjectId",
            "        #sid: GroupSid",
            "        #distinguished_name: GroupDistinguishedName",
            "    #azure_resources:",
            "      #- resource_id: AzureResourceId",
            "    #amazon_resources:",
            "      #- amazon_resource_id: AmazonResourceName",
            "    #google_cloud_resources:",
            "      #- full_resource_name: GcpFullResourceName",
            "  #actions:",
            "    #isolate_devices:",
            "      #- device_id: DeviceId",
            "        #isolation_type: selective",
            "    #collect_investigation_packages:",
            "      #- device_id: DeviceId",
            "    #run_antivirus_scans:",
            "      #- device_id: DeviceId",
            "    #initiate_investigations:",
            "      #- device_id: DeviceId",
            "    #restrict_app_executions:",
            "      #- device_id: DeviceId",
            "    #allow_files:",
            "      #- sha1: SHA1",
            "        #sha256: SHA256",
            "        #device_groups: [Developer workstations]",
            "    #block_files:",
            "      #- sha1: SHA1",
            "        #sha256: SHA256",
            "        #device_groups: [Tier 0, Servers]",
            "    #stop_and_quarantine_files:",
            "      #- device_id: DeviceId",
            "        #sha1: SHA1",
            "    #disable_users:",
            "      #- account_sid: AccountSid",
            "    #force_user_password_resets:",
            "      #- account_sid: AccountSid",
            "    #mark_users_as_compromised:",
            "      #- account_object_id: AccountObjectId",
            "    #soft_delete_emails:",
            "      #- network_message_id: NetworkMessageId",
            "        #recipient: RecipientEmailAddress",
            "    #hard_delete_emails:",
            "      #- network_message_id: NetworkMessageId",
            "        #recipient: RecipientEmailAddress",
            "    #move_emails_to_deleted_items:",
            "      #- network_message_id: NetworkMessageId",
            "        #recipient: RecipientEmailAddress",
            "    #move_emails_to_inbox:",
            "      #- network_message_id: NetworkMessageId",
            "        #recipient: RecipientEmailAddress",
            "    #move_emails_to_junk:",
            "      #- network_message_id: NetworkMessageId",
            "        #recipient: RecipientEmailAddress",
            "  #scope:",
            "    #device_groups: [Tier 0, Servers]",
            "  #incident:  # beta-only",
            "    #exclude_from_correlation: true",
            "  #exclusions:",
            "    #- query: |",
            "        #...",
            "      #reason: ",
            "      #tenant: ",
            "      #let:",
            "        #key: "
        ]
    },
    "Platform configuration : Microsoft Sentinel Template": {
        "prefix": "tide-sentinel",
