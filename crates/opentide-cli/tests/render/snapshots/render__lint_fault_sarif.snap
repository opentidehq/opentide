            "threshold_lookback | - | ThresholdLookback | https://opentide.org/docs/cli/diagnostics#threshold_lookback",
            "yaml_parse | error | YamlParse | https://opentide.org/docs/cli/diagnostics#yaml_parse"
          ],
          "version": "0.28.1"
        }
      }
    }
  ],
  "version": "2.1.0"
}
