            {
              "id": "falco_no_evttype",
              "name": "FalcoNoEvttype",
              "helpUri": "https://opentide.org/docs/cli/diagnostics#falco_no_evttype",
              "shortDescription": {
                "text": "The rule cannot be narrowed to a few event types (`evt.type`), so it runs on every event; Falco and Sysdig warn about the performance penalty."
