        INDEX_NAME@5..6
          SOURCE_TEXT@5..6 "a"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    EVAL_COMMAND@9..23
      EVAL_KW@9..13 "EVAL"
      WHITESPACE@13..14 " "
      FIELD_ASSIGNMENT_OR_EXPRESSION@14..23
        QUALIFIED_NAME@14..15
          IDENTIFIER@14..15
            IDENT@14..15 "x"
        WHITESPACE@15..16 " "
        EQ@16..17 "="
        WHITESPACE@17..18 " "
        BINARY_EXPRESSION@18..23
          NUMBER@18..19
            NUMBER_LIT@18..19 "1"
          WHITESPACE@19..20 " "
          PLUS@20..21 "+"
          WHITESPACE@21..22 " "
