| LIMIT 1
SOURCE_FILE@0..9
  QUERY@0..9
    PIPE@0..1 "|"
    WHITESPACE@1..2 " "
    LIMIT_COMMAND@2..9
      LIMIT_KW@2..7 "LIMIT"
      WHITESPACE@7..8 " "
      NUMBER@8..9
        NUMBER_LIT@8..9 "1"
--- errors
