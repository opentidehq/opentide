| tstats `security_content_summariesonly` count min(_time) as firstTime max(_time) as lastTime
  from datamodel=Endpoint.Processes
  where Processes.process_name IN ("cmd.exe", "powershell.exe") Processes.my_site_field=1
  by Processes.dest Processes.user Processes.parent_process_name Processes.proces_name
| `drop_dm_object_name(Processes)`
| `security_content_ctime(firstTime)`
| where process_name="cmd.exe"
| append [| tstats count from datamodel=Endpont.Processes by Processes.dest]
