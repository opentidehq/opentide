is_compute_service and proc.name in (oops and (gcp.methodName contains "compute.instances.insert"  or gcp.methodName contains "compute.instances.update"  or gcp.methodName contains "compute.instances.setServiceAccount" or gcp.methodName contains "compute.instances.setIamPolicy" or gcp.methodName contains "compute.instances.updateAccessConfig" or gcp.methodName contains "compute.instances.updateNetworkInterface")
