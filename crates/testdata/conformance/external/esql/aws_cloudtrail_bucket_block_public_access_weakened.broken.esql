from * metadata _id, _index, _version | frobnicate eventSource=="s3.amazonaws.com" and eventName=="PutBucketPublicAccessBlock" and (requestParameters.PublicAccessBlockConfiguration.RestrictPublicBuckets=="false" or requestParameters.PublicAccessBlockConfiguration.BlockPublicAcls=="false" or requestParameters.PublicAccessBlockConfiguration.BlockPublicPolicy=="false" or requestParameters.PublicAccessBlockConfiguration.IgnorePublicAcls=="false") and (errorCode=="Success" or errorCode is null)
