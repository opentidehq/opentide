{#- GitHub Actions: `.github/workflows/opentide.yml`. -#}
{% import "scripts.sh.j2" as sh %}
{#- The App token `--app-token` creates, for the jobs that push to the
    default branch; `token(...)` is the checkout's `token:` line. -#}
{% macro app_token_step() -%}
- name: Create GitHub App token
  id: app-token
  uses: actions/create-github-app-token@v3
  with:
    client-id: ${{ vars.OPENTIDE_APP_CLIENT_ID }}
    private-key: ${{ secrets.OPENTIDE_APP_PRIVATE_KEY }}
    permission-contents: write
{%- endmacro %}
{% macro setup(full_history=false, ref=none, token=false) -%}
{% if token %}
[[ app_token_step() ]]
{% endif %}
- uses: actions/checkout@v7
{% if ref or full_history or token %}
  with:
{% if ref %}
    ref: [[ ref ]]
{% endif %}
{% if token %}
    token: ${{ steps.app-token.outputs.token }}
{% endif %}
{% if ref or full_history %}
    fetch-depth: 0
{% endif %}
{% endif %}
- uses: actions/setup-python@v7
  with:
    python-version: "[[ python ]]"
- run: [[ pip ]]
{%- endmacro %}
{% macro secrets(names) -%}
env:
{% for name in names %}
  [[ name | scalar(2) ]]: ${{ secrets.[[ name ]] }}
{% endfor %}
{%- endmacro %}
{% macro reviewed(name, commands, cond=none, names=none) -%}
- name: [[ name ]]
{% if cond %}
  if: ${{ [[ cond ]] }}
{% endif %}
{% if names %}
  [[ secrets(names) | indent(2) ]]
{% endif %}
  run: |
{% for line in restore + commands %}
    [[ line ]]
{% endfor %}
{%- endmacro %}
{% set identity = 'git config user.name "github-actions[bot]"\ngit config user.email "github-actions[bot]@users.noreply.github.com"' %}
[[ header ]]name: opentide

on:
  pull_request:
  push:
    branches:
      - [[ branch ]]

env:
  OPENTIDE_REPO_ROOT: ${{ github.workspace }}
  OPENTIDE_DEFAULT_BRANCH: [[ branch | scalar(2) ]]
  [[ version_entry ]]

{% if explorer_pages %}
permissions:
  contents: read

{% endif %}
jobs:
  validate:
    name: Validate
    runs-on: ubuntu-latest
    steps:
      [[ setup(full_history=(queries or lint_changed)) | indent(6) ]]
{% for command in validate_sarif %}
      - run: [[ command ]]
{% endfor %}
{% for query in queries %}
      [[ reviewed("Validate " ~ query.platform ~ " queries on reviewed tenants", [query.command], not_skipped, query.secrets) | indent(6) ]]
{% endfor %}
      - name: Upload opentide reports
        if: ${{ !cancelled() }}
        uses: actions/upload-artifact@v7
        with:
          name: opentide-reports
          path: opentide-reports/
          if-no-files-found: ignore
  code_scanning:
    name: Code scanning
    runs-on: ubuntu-latest
    needs: validate
    if: ${{ !cancelled() && !github.event.repository.private }}
    permissions:
      security-events: write
    steps:
      - name: Download opentide reports
        uses: actions/download-artifact@v8
        continue-on-error: true
        with:
          name: opentide-reports
          path: opentide-reports/
{% for command in gate_commands %}
      - name: Upload [[ command ]] findings to code scanning
        if: ${{ hashFiles('opentide-reports/[[ command ]].sarif') != '' }}
        uses: github/codeql-action/upload-sarif@v4
        continue-on-error: true
        with:
          sarif_file: opentide-reports/[[ command ]].sarif
{% endfor %}
  generate:
    name: Generate
    runs-on: ubuntu-latest
    needs: validate
    steps:
      [[ setup() | indent(6) ]]
      - run: opentide generate
{% if staging %}
  deploy_staging:
    name: Deploy Staging
    runs-on: ubuntu-latest
    needs: generate
    if: ${{ [[ premerge ]] && [[ not_skipped ]] }}
    concurrency:
      group: opentide-deploy-staging
      cancel-in-progress: false
      queue: max
{% if credentials %}
    [[ secrets(credentials) | indent(4) ]]
{% endif %}
    steps:
      [[ setup(full_history=true) | indent(6) ]]
      [[ reviewed("Deploy staging to reviewed tenants", staging_commands) | indent(6) ]]
{% endif %}
{% if inflight %}
  inflight_shards:
    name: Update inflight preview shards
    needs: generate
    if: [[ premerge ]]
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout pull request head
        uses: actions/checkout@v7
        with:
          ref: ${{ github.head_ref }}
          fetch-depth: 0
      - uses: actions/setup-python@v7
        with:
          python-version: "[[ python ]]"
      - run: [[ pip ]]
      - name: Merge inflight shards from default branch
        run: |
          git fetch origin [[ branch ]]
          [[ sh.default_branch_shards("origin/" ~ branch) | indent(10) ]]
      - name: Write inflight shards for changed objects
        run: opentide generate inflight
        env:
          OPENTIDE_REPO_ROOT: ${{ github.workspace }}
      - name: Push inflight shards to default branch
        run: |
          [[ identity | indent(10) ]]
          [[ sh.publish_shards('git push origin "HEAD:' ~ branch ~ '"', "git fetch origin " ~ branch) | indent(10) ]]
  inflight_prune:
    name: Prune inflight preview shards
    needs: generate
    if: [[ production ]]
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
{% if app_token %}
      [[ app_token_step() | indent(6) ]]
{% endif %}
      - uses: actions/checkout@v7
        with:
{% if app_token %}
          token: ${{ steps.app-token.outputs.token }}
{% endif %}
          fetch-depth: 0
      - uses: actions/setup-python@v7
        with:
          python-version: "[[ python ]]"
      - run: [[ pip ]]
      - name: Prune superseded inflight shards
        run: opentide generate inflight prune
        env:
          OPENTIDE_REPO_ROOT: ${{ github.workspace }}
      - name: Push pruned inflight shards
        run: |
          [[ identity | indent(10) ]]
          [[ sh.commit_and_push("ci: prune inflight preview shards [skip ci]", "No inflight prune changes", "git push origin HEAD:" ~ branch, "git fetch origin " ~ branch) | indent(10) ]]
{% endif %}
  deploy_production:
    name: Deploy Production
    runs-on: ubuntu-latest
    needs: generate
    if: ${{ [[ production ]] && [[ not_skipped ]] }}
    concurrency:
      group: opentide-deploy-production
      cancel-in-progress: false
      queue: max
    permissions:
      contents: write
{% if credentials %}
    [[ secrets(credentials) | indent(4) ]]
{% endif %}
    steps:
      [[ setup(full_history=true, token=app_token) | indent(6) ]]
      - name: Use the default branch's deployment state
        run: |
          [[ identity | indent(10) ]]
          [[ sh.overlay("git fetch origin " ~ branch) | indent(10) ]]
      - run: [[ dry_run ]]
      - name: Deploy
        id: deploy
        run: [[ deploy ]]
      - name: Commit deployment write-backs
        if: ${{ always() && steps.deploy.outcome != 'skipped' }}
        run: |
          [[ identity | indent(10) ]]
          [[ sh.writeback(rules, 'git push origin "HEAD:' ~ branch ~ '"', "git fetch origin " ~ branch, 'git push origin "$state_commit:refs/opentide/deployment-state/$state_commit"') | indent(10) ]]
{% if sharing %}
  share:
    name: Share
    runs-on: ubuntu-latest
    needs: [generate, deploy_production]
    if: ${{ !cancelled() && needs.generate.result == 'success' && [[ production ]] && [[ not_skipped ]] }}
{% if sharing_credentials %}
    [[ secrets(sharing_credentials) | indent(4) ]]
{% endif %}
    steps:
      [[ setup(ref=branch) | indent(6) ]]
      # API key environment variables named in sharing.toml come from the CI secret store.
      - run: opentide share push --changed
{% endif %}
  document:
    name: Document
    runs-on: ubuntu-latest
    needs: generate
    if: [[ production ]]
    steps:
      [[ setup() | indent(6) ]]
{% for command in docs %}
      - run: [[ command ]]
{% endfor %}
{% if docs %}
      - name: Upload documentation
        uses: actions/upload-artifact@v7
        with:
          name: opentide-docs
          path: [[ docs_path ]]
{% endif %}
{% if explorer_pages %}
  explorer:
    name: Build explorer
    runs-on: ubuntu-latest
    needs: document
    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Checkout explorer
        uses: actions/checkout@v7
        with:
          repository: opentidehq/explorer
          # [[ explorer_release ]], the explorer release this opentide's bundle is built for
          ref: [[ explorer_commit ]]
          path: explorer

      - uses: actions/setup-python@v7
        with:
          python-version: "[[ python ]]"

      - uses: actions/setup-node@v7
        with:
          node-version: "22"

      - name: Install opentide
        run: [[ pip ]]

      - name: Export explorer bundle
        run: opentide --json generate explorer
        env:
          OPENTIDE_REPO_ROOT: ${{ github.workspace }}

      - name: Build explorer static site
        working-directory: explorer
        run: |
          npm ci
          npm run build
        env:
          OPENTIDE_BUNDLE: ${{ github.workspace }}/.opentide/exports/explorer.bundle.json
          NEXT_PUBLIC_BASE_PATH: /${{ github.event.repository.name }}

      - name: Collect static site
        run: |
          mkdir -p ./out
          mv explorer/out ./out/explorer

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v5
        with:
          path: ./out/explorer
  deploy-explorer:
    name: Deploy explorer to GitHub Pages
    runs-on: ubuntu-latest
    needs: explorer
    if: [[ production ]]
    concurrency:
      group: pages
      cancel-in-progress: false
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v5
{% endif %}
[[ user_region ]]
