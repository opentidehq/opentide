{#- A Mermaid flowchart (documentation/diagram/flowchart.py, graph.py). -#}
{% macro node(n) %}
{% if n.shape == "hex" %}
{{ n.id }}{{ "{{" }}"{{ n.label }}"{{ "}}" }}
{% elif n.shape == "stadium" %}
{{ n.id }}(["{{ n.label }}"])
{% elif n.shape == "circle" %}
{{ n.id }}(("{{ n.label }}"))
{% else %}
{{ n.id }}["{{ n.label }}"]
{% endif %}
{% endmacro %}
{{ kind }} {{ direction }}
{% for group in subgraphs %}
subgraph "{{ group.title }}"
{% for n in group.nodes %}
{{ node(n) }}
{%- endfor %}
end
{% endfor %}
{% for n in nodes %}
{{ node(n) }}
{%- endfor %}
{% for edge in edges %}
{{ edge.source }} {{ "<-->" if edge.both_ways else "-->" }}{% if edge.label %}|{{ edge.label }}|{% endif %} {{ edge.target }}
{% endfor %}
