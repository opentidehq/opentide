{#- A detection rule's page (documentation/objects/rule.py). Each section is
    a block; the page is its non-blank blocks, a blank line between them. -#}
{% import "macros.md.j2" as md %}
{% macro section_status(rows) %}
{% if rows %}
## Status
{{ md.table(["Field", "Value"], rows) }}
{% endif %}
{% endmacro %}
{% macro section_detection_model(link) %}
{% if link %}
## Detection model
- **Objective**: {{ link }}
{% endif %}
{% endmacro %}
{% macro section_response(r) %}
{% if r %}
## Response

- **Alert severity**: {{ r.alert_severity }}
{% if r.playbook %}
- **Playbook**: {{ r.playbook }}
{% endif %}
{% if r.responders %}
- **Responders**: {{ r.responders }}
{% endif %}
{% if r.procedure %}
### Procedure
- **Analysis**: {{ r.procedure.analysis }}
{% if r.procedure.containment %}
- **Containment**: {{ r.procedure.containment }}
{% endif %}
{% if r.procedure.searches %}
#### Searches
{% for search in r.procedure.searches %}
- **{{ search.purpose }}** ({{ search.system }})
```text
{{ search.query }}
```
{% endfor %}
{% endif %}
{% endif %}
{% endif %}
{% endmacro %}
{% macro section_platform_body(p) %}
- **Enabled**: `{{ p.enabled }}`
{% if p.status %}
- **Status**: `{{ p.status }}`
{% endif %}
{% if p.alert_title %}
- **Alert title**: {{ p.alert_title }}
{% endif %}
{% for mapping in p.entity_mappings %}
- **Entity mapping**: {{ mapping }}
{% endfor %}
{% if p.query %}

```{{ p.language }}
{{ p.query }}
```
{% endif %}
{% endmacro %}
{% macro section_platforms(list) %}
{% if list %}
## Platform configurations
{% for p in list %}
{{ md.fold(flavor, p.name, section_platform_body(p)) }}
{% endfor %}
{% endif %}
{% endmacro %}
{{ [
    md.title(title),
    md.metadata(metadata),
    md.references(references),
    md.description(description),
    section_status(status),
    md.techniques(techniques),
    section_detection_model(detection_model),
    section_response(response),
    section_platforms(platforms),
    md.coverage(coverage),
]|join_blocks }}
