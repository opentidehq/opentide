{
  "about": "The cross-SDK conformance suite (UC-5.4, #839): every operation on every corpus, run through the Rust SDK, the Python SDK and the Node SDK, must give byte-identical documents. tests/conformance/README.md describes the fields; `cargo xtask conformance` lays the corpora out and runs the runners.",
  "corpora": [
    {
      "name": "tide_corpus",
      "kind": "tide_corpus",
      "about": "tests/fixtures/tide_corpus/current in today's layout: one threat, one objective, ten rules on the nine platforms"
    },
    {
      "name": "heavy",
      "kind": "heavy",
      "seed": 20261107,
      "about": "the heavy workspace (cargo xtask corpus generate --seed 20261107): 300 threats, 300 objectives, 500 rules"
    },
    {
      "name": "faults",
      "kind": "faults",
      "about": "the combined fault workspace (cargo xtask corpus faults --out): every fault kind not marked isolated, applied once"
    },
    {
      "name": "configuration",
      "kind": "configuration_faults",
      "about": "each configuration fault kind of tests/corpora/faults.toml applied alone to the base workspace: one corpus each, configuration/<kind>"
    }
  ],
  "stand_ins": [
    {
      "name": "sentinel_one",
      "environment": {
        "S1_API_TOKEN": "s1-stand-in-token"
      },
      "about": "tests/cassettes/sentinel_one/tenant.py: PowerQuery (`slow` polled, `fails` FAILED, `| syntax` refused) and STAR rules"
    },
    {
      "name": "harfanglab",
      "environment": {
        "HARFANGLAB_API_TOKEN": "hl-stand-in-token"
      },
      "about": "tests/cassettes/harfanglab/tenant.py: telemetry rows (nested, mixed keys, an integer), Sigma rules"
    }
  ],
  "tenants": [
    { "name": "soc", "platform": "sentinel_one", "setup": { "url": "{sentinel_one}", "api_token": "$S1_API_TOKEN", "account_id": "42" }, "environment": { "S1_API_TOKEN": "s1-stand-in-token" }, "about": "the SentinelOne stand-in" },
    { "name": "lab", "platform": "harfanglab", "setup": { "url": "{harfanglab}", "api_token": "$HARFANGLAB_API_TOKEN", "type": "Sigma" }, "environment": { "HARFANGLAB_API_TOKEN": "hl-stand-in-token" }, "about": "the HarfangLab stand-in, Sigma rules" },
    { "name": "closed", "platform": "sentinel_one", "setup": { "url": "http://127.0.0.1:9", "api_token": "$S1_API_TOKEN", "account_id": "42" }, "environment": { "S1_API_TOKEN": "s1-stand-in-token" }, "about": "a loopback port nothing listens on: tenant_unreachable" },
    { "name": "unset", "platform": "sentinel_one", "setup": { "url": "{sentinel_one}", "api_token": "$S1_API_TOKEN", "account_id": "42" }, "environment": {}, "about": "a credential the environment does not set: Connection.open fails with credential_unset" }
  ],
  "operations": [
