{
  "about": "The cross-SDK conformance suite (UC-5.4, #839): every operation on every corpus, run through the Rust SDK, the Python SDK and the Node SDK, must give byte-identical documents. tests/conformance/README.md describes the fields; `cargo xtask conformance` lays the corpora out and runs the runners.",
  "corpora": [
    {
      "name": "tide_corpus",
      "kind": "tide_corpus",
      "about": "tests/fixtures/tide_corpus/current in today's layout: one threat, one objective, ten rules on the nine platforms"
    },
    {
      "name": "heavy",
      "kind": "heavy",
      "seed": 20261107,
      "about": "the heavy workspace (cargo xtask corpus generate --seed 20261107): 300 threats, 300 objectives, 500 rules"
    },
    {
      "name": "faults",
      "kind": "faults",
      "about": "the combined fault workspace (cargo xtask corpus faults --out): every fault kind not marked isolated, applied once"
    },
    {
      "name": "configuration",
      "kind": "configuration_faults",
      "about": "each configuration fault kind of tests/corpora/faults.toml applied alone to the base workspace: one corpus each, configuration/<kind>"
    }
  ],
  "operations": [
    { "name": "validate", "call": "validate" },
    { "name": "validate-strict-warn", "call": "validate", "options": { "strict": true, "queries": "warn" } },
    { "name": "validate-queries-off", "call": "validate", "options": { "queries": "off" } },
    { "name": "validate-check-schema", "call": "validate", "options": { "check": "schema" } },
    { "name": "validate-check-configuration", "call": "validate", "options": { "check": "configuration" } },
    { "name": "validate-check-sharing-config", "call": "validate", "options": { "check": "sharing-config" } },
    { "name": "validate-type-rule", "call": "validate", "options": { "types": ["rule"] } },
    { "name": "lint", "call": "lint" },
    { "name": "lint-metadata-filenames-strict", "call": "lint", "options": { "checks": ["metadata", "filenames"], "strict": true } },
    { "name": "lint-placeholders", "call": "lint", "options": { "checks": ["placeholders"] } },
    { "name": "info", "call": "info" },
    { "name": "catalog", "call": "catalog" },
    { "name": "rules", "call": "rules" },
    { "name": "objectives", "call": "objectives" },
    { "name": "threats", "call": "threats" },
    { "name": "coverage-T1059", "call": "coverage", "technique": "T1059" },
    { "name": "coverage-T1003.001", "call": "coverage", "technique": "T1003.001" },
    { "name": "deploy_plan", "call": "deploy_plan" },
    { "name": "deploy_plan-preview-release", "call": "deploy_plan", "options": { "strategies": ["PREVIEW", "RELEASE"] } },
    { "name": "deploy_plan-sentinel-drop-deprecated", "call": "deploy_plan", "options": { "platform": "sentinel", "keep_deprecated": false } },
    { "name": "from_files-validate", "call": "validate", "open": "files", "corpora": ["tide_corpus", "heavy"] },
    { "name": "from_files-lint", "call": "lint", "open": "files", "corpora": ["tide_corpus", "heavy"] },
    { "name": "from_files-info", "call": "info", "open": "files", "corpora": ["tide_corpus", "heavy"] },
    { "name": "from_files-catalog", "call": "catalog", "open": "files", "corpora": ["tide_corpus", "heavy"] },
    { "name": "run_json-commands", "call": "run_json", "argv": ["commands"], "repo": false, "corpora": ["tide_corpus"] },
    { "name": "run_json-explain", "call": "run_json", "argv": ["explain", "invalid_uuid"], "repo": false, "corpora": ["tide_corpus"] },
    { "name": "run_json-validate", "call": "run_json", "argv": ["validate"] },
    { "name": "run_json-validate-strict-warn", "call": "run_json", "argv": ["validate", "--strict", "--queries", "warn"] },
    { "name": "run_json-lint", "call": "run_json", "argv": ["lint"] },
    { "name": "run_json-info", "call": "run_json", "argv": ["info"] },
    { "name": "run_json-info-rules", "call": "run_json", "argv": ["info", "rules"] },
    { "name": "run_json-info-threats", "call": "run_json", "argv": ["info", "threats"] },
    { "name": "run_json-info-objectives", "call": "run_json", "argv": ["info", "objectives"] },
    { "name": "run_json-info-coverage", "call": "run_json", "argv": ["info", "coverage"] },
    { "name": "run_json-info-vocab", "call": "run_json", "argv": ["info", "vocab"] },
    { "name": "run_json-info-catalog", "call": "run_json", "argv": ["info", "catalog"] },
    { "name": "run_json-rules-unreviewed", "call": "run_json", "argv": ["rules", "unreviewed"] },
    { "name": "run_json-deploy-dry-run", "call": "run_json", "argv": ["deploy", "--dry-run", "--all"] }
  ]
}
