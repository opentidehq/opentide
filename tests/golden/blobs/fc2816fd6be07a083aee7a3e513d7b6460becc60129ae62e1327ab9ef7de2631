# Generated by opentide — regenerate with `opentide setup ci azure`
# Platform credentials are read from the environment. Set these in the CI secret store:
#   AZURE_CLIENT_ID
#   AZURE_CLIENT_SECRET
#   AZURE_SUBSCRIPTION_ID
#   AZURE_TENANT_ID
#   AZURE_WORKSPACE_ID
#   CBC_ORG_KEY
#   CBC_TOKEN
#   CBC_URL
#   ELASTIC_PROD_API_KEY
#   ELASTIC_STAGING_API_KEY
#   HARFANGLAB_API_TOKEN
#   MDE_CLIENT_ID
#   MDE_CLIENT_SECRET
#   MDE_TENANT_ID
#   SENTINEL_ONE_API_TOKEN
#   SPLUNK_APP
#   SPLUNK_PORT
#   SPLUNK_TOKEN
#   SPLUNK_URL
#   SYSDIG_SECURE_API_TOKEN
trigger:
  branches:
    include:
      - '*'

# Azure Repos Git ignores pr:. Add a build validation policy on the
# default branch so pull requests set Build.Reason to PullRequest.
# Staging deploy stays gated on that reason. Hosted Azure Pipelines
# (GitHub or Bitbucket) honor pr: as written.
pr:
  branches:
    include:
      - development

pool:
  vmImage: ubuntu-latest

variables:
  OPENTIDE_REPO_ROOT: $(Build.SourcesDirectory)
  OPENTIDE_VERSION: "0.23.0"

# Azure cannot serialise a job from YAML alone. Add an Exclusive lock
# check to a resource the Deploy stage uses (for example an environment
# or the agent pool); this line then queues runs in order instead of
# cancelling all but the latest.
lockBehavior: sequential

stages:
  - stage: Validate
    displayName: Validate
    jobs:
      - job: validate
        displayName: Validate objects
        steps:
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install "opentide==$OPENTIDE_VERSION"
            displayName: Install opentide
          - script: |
              set -e
              mkdir -p opentide-reports
              opentide validate --strict --format sarif --output opentide-reports/validate.sarif
              opentide lint --strict --format sarif --output opentide-reports/lint.sarif
          - task: PublishBuildArtifacts@1
            displayName: Publish opentide reports
            condition: succeededOrFailed()
            inputs:
              PathtoPublish: $(Build.SourcesDirectory)/opentide-reports
              ArtifactName: CodeAnalysisLogs
      - job: validate_query_carbon-black-cloud
        displayName: Validate query (carbon_black_cloud)
        steps:
          - checkout: self
            persistCredentials: true
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install "opentide==$OPENTIDE_VERSION"
            displayName: Install opentide
          - script: |
              set -e
              commit="${SYSTEM_PULLREQUEST_SOURCECOMMITID:-${BUILD_SOURCEVERSION:-}}"; if [ -n "$commit" ] && git log -1 --format=%B "$commit" 2>/dev/null | grep -qF '[skip deploy]'; then echo "[skip deploy] or the skip-deploy label: no live query check, deploy or share in this pipeline."; exit 0; fi
              rm -rf -- .opentide/configurations
              if [ "$(git rev-parse --is-shallow-repository)" = true ]; then git fetch --depth=1 origin development; else git fetch origin development; fi
              if ! git cat-file -e FETCH_HEAD:.opentide/configurations 2>/dev/null; then echo "The default branch has no .opentide/configurations yet, so no tenant is reviewed. Skipped without using platform credentials."; exit 0; fi
              git checkout FETCH_HEAD -- .opentide/configurations
              if grep -qs '^[^#]*tenants' .opentide/configurations/platforms/carbon_black_cloud.toml; then opentide validate query --platform carbon_black_cloud --live --changed; else echo "The default branch has no carbon_black_cloud tenant yet, so no tenant is reviewed. Skipped carbon_black_cloud live query validation without using platform credentials."; fi
