              rm -rf -- .opentide/configurations
              if [ "$(git rev-parse --is-shallow-repository)" = true ]; then git fetch --depth=1 origin development; else git fetch origin development; fi
              if ! git cat-file -e FETCH_HEAD:.opentide/configurations 2>/dev/null; then echo "The default branch has no .opentide/configurations yet, so no tenant is reviewed. Skipped without using platform credentials."; exit 0; fi
              git checkout FETCH_HEAD -- .opentide/configurations
              if grep -qs '^[^#]*tenants' .opentide/configurations/platforms/defender_for_endpoint.toml; then opentide validate query --platform defender_for_endpoint --live --changed; else echo "The default branch has no defender_for_endpoint tenant yet, so no tenant is reviewed. Skipped defender_for_endpoint live query validation without using platform credentials."; fi
      - job: validate_query_elastic
        displayName: Validate query (elastic)
        steps:
          - checkout: self
            persistCredentials: true
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install "opentide==$OPENTIDE_VERSION"
            displayName: Install opentide
          - script: |
              set -e
              commit="${SYSTEM_PULLREQUEST_SOURCECOMMITID:-${BUILD_SOURCEVERSION:-}}"; if [ -n "$commit" ] && git log -1 --format=%B "$commit" 2>/dev/null | grep -qF '[skip deploy]'; then echo "[skip deploy] or the skip-deploy label: no live query check, deploy or share in this pipeline."; exit 0; fi
              rm -rf -- .opentide/configurations
              if [ "$(git rev-parse --is-shallow-repository)" = true ]; then git fetch --depth=1 origin development; else git fetch origin development; fi
              if ! git cat-file -e FETCH_HEAD:.opentide/configurations 2>/dev/null; then echo "The default branch has no .opentide/configurations yet, so no tenant is reviewed. Skipped without using platform credentials."; exit 0; fi
              git checkout FETCH_HEAD -- .opentide/configurations
              if grep -qs '^[^#]*tenants' .opentide/configurations/platforms/elastic.toml; then if [ -z "$ELASTIC_API_KEY" ]; then echo skip elastic live query validation ELASTIC_API_KEY; exit 2; else opentide validate query --platform elastic --live --changed; fi; else echo "The default branch has no elastic tenant yet, so no tenant is reviewed. Skipped elastic live query validation without using platform credentials."; fi
      - job: validate_query_sentinel
        displayName: Validate query (sentinel)
        steps:
          - checkout: self
            persistCredentials: true
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install "opentide==$OPENTIDE_VERSION"
            displayName: Install opentide
          - script: |
              set -e
              commit="${SYSTEM_PULLREQUEST_SOURCECOMMITID:-${BUILD_SOURCEVERSION:-}}"; if [ -n "$commit" ] && git log -1 --format=%B "$commit" 2>/dev/null | grep -qF '[skip deploy]'; then echo "[skip deploy] or the skip-deploy label: no live query check, deploy or share in this pipeline."; exit 0; fi
              rm -rf -- .opentide/configurations
              if [ "$(git rev-parse --is-shallow-repository)" = true ]; then git fetch --depth=1 origin development; else git fetch origin development; fi
              if ! git cat-file -e FETCH_HEAD:.opentide/configurations 2>/dev/null; then echo "The default branch has no .opentide/configurations yet, so no tenant is reviewed. Skipped without using platform credentials."; exit 0; fi
              git checkout FETCH_HEAD -- .opentide/configurations
              if grep -qs '^[^#]*tenants' .opentide/configurations/platforms/sentinel.toml; then opentide validate query --platform sentinel --live --changed; else echo "The default branch has no sentinel tenant yet, so no tenant is reviewed. Skipped sentinel live query validation without using platform credentials."; fi
      - job: validate_query_sentinel-one
        displayName: Validate query (sentinel_one)
        steps:
          - checkout: self
            persistCredentials: true
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install "opentide==$OPENTIDE_VERSION"
            displayName: Install opentide
          - script: |
              set -e
              commit="${SYSTEM_PULLREQUEST_SOURCECOMMITID:-${BUILD_SOURCEVERSION:-}}"; if [ -n "$commit" ] && git log -1 --format=%B "$commit" 2>/dev/null | grep -qF '[skip deploy]'; then echo "[skip deploy] or the skip-deploy label: no live query check, deploy or share in this pipeline."; exit 0; fi
              rm -rf -- .opentide/configurations
              if [ "$(git rev-parse --is-shallow-repository)" = true ]; then git fetch --depth=1 origin development; else git fetch origin development; fi
              if ! git cat-file -e FETCH_HEAD:.opentide/configurations 2>/dev/null; then echo "The default branch has no .opentide/configurations yet, so no tenant is reviewed. Skipped without using platform credentials."; exit 0; fi
              git checkout FETCH_HEAD -- .opentide/configurations
              if grep -qs '^[^#]*tenants' .opentide/configurations/platforms/sentinel_one.toml; then opentide validate query --platform sentinel_one --live --changed; else echo "The default branch has no sentinel_one tenant yet, so no tenant is reviewed. Skipped sentinel_one live query validation without using platform credentials."; fi
      - job: validate_query_splunk
        displayName: Validate query (splunk)
        steps:
          - checkout: self
            persistCredentials: true
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install "opentide==$OPENTIDE_VERSION"
            displayName: Install opentide
          - script: |
              set -e
              commit="${SYSTEM_PULLREQUEST_SOURCECOMMITID:-${BUILD_SOURCEVERSION:-}}"; if [ -n "$commit" ] && git log -1 --format=%B "$commit" 2>/dev/null | grep -qF '[skip deploy]'; then echo "[skip deploy] or the skip-deploy label: no live query check, deploy or share in this pipeline."; exit 0; fi
              rm -rf -- .opentide/configurations
              if [ "$(git rev-parse --is-shallow-repository)" = true ]; then git fetch --depth=1 origin development; else git fetch origin development; fi
              if ! git cat-file -e FETCH_HEAD:.opentide/configurations 2>/dev/null; then echo "The default branch has no .opentide/configurations yet, so no tenant is reviewed. Skipped without using platform credentials."; exit 0; fi
              git checkout FETCH_HEAD -- .opentide/configurations
              if grep -qs '^[^#]*tenants' .opentide/configurations/platforms/splunk.toml; then opentide validate query --platform splunk --live --changed; else echo "The default branch has no splunk tenant yet, so no tenant is reviewed. Skipped splunk live query validation without using platform credentials."; fi

  - stage: Generate
    displayName: Generate
    dependsOn: Validate
    jobs:
      - job: generate
        displayName: Generate framework artifacts
        steps:
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install "opentide==$OPENTIDE_VERSION"
            displayName: Install opentide
          - script: |
              set -e
              opentide generate

  - stage: Deploy
    displayName: Deploy
    dependsOn: Generate
    jobs:
      - job: deploy_staging
        displayName: Deploy Staging
        condition: and(eq(variables['Build.Reason'], 'PullRequest'), eq(variables['System.PullRequest.TargetBranch'], 'refs/heads/development'))
        steps:
          - checkout: self
            persistCredentials: true
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install "opentide==$OPENTIDE_VERSION"
            displayName: Install opentide
          - script: |
              set -e
              commit="${SYSTEM_PULLREQUEST_SOURCECOMMITID:-${BUILD_SOURCEVERSION:-}}"; if [ -n "$commit" ] && git log -1 --format=%B "$commit" 2>/dev/null | grep -qF '[skip deploy]'; then echo "[skip deploy] or the skip-deploy label: no live query check, deploy or share in this pipeline."; exit 0; fi
              rm -rf -- .opentide/configurations
              if [ "$(git rev-parse --is-shallow-repository)" = true ]; then git fetch --depth=1 origin development; else git fetch origin development; fi
              if ! git cat-file -e FETCH_HEAD:.opentide/configurations 2>/dev/null; then echo "The default branch has no .opentide/configurations yet, so no tenant is reviewed. Skipped without using platform credentials."; exit 0; fi
              git checkout FETCH_HEAD -- .opentide/configurations
              opentide deploy --dry-run --strategy PREVIEW
              opentide deploy --strategy PREVIEW --skip-unconfigured
      - job: inflight_shards
        displayName: Inflight preview shards
        condition: and(eq(variables['Build.Reason'], 'PullRequest'), eq(variables['System.PullRequest.TargetBranch'], 'refs/heads/development'))
        steps:
          - checkout: self
            persistCredentials: true
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install "opentide==$OPENTIDE_VERSION"
            displayName: Install opentide
          - script: |
              set -e
              git fetch origin development
              rm -rf .opentide/inflight
              git rev-parse "origin/development" > "$(git rev-parse --git-path opentide-inflight-base)"
              git checkout "$(cat "$(git rev-parse --git-path opentide-inflight-base)")" -- .opentide/inflight 2>/dev/null || mkdir -p .opentide/inflight
              export OPENTIDE_REPO_ROOT="$BUILD_SOURCESDIRECTORY"
              opentide generate inflight
              git config user.email "azure-pipelines@opentide.local"
              git config user.name "azure-pipelines"
              shards_repo="$PWD"
              shards_base="$(mktemp -d)"
              git worktree add --detach "$shards_base" "$(cat "$(git rev-parse --git-path opentide-inflight-base)")"
              trap 'cd "$shards_repo" && git worktree remove --force "$shards_base"' EXIT
              rm -rf "$shards_base/.opentide/inflight"
              mkdir -p "$shards_base/.opentide"
              cp -R .opentide/inflight "$shards_base/.opentide/inflight"
              cd "$shards_base" || exit
              mkdir -p .opentide/inflight
              git add .opentide/inflight/
              if git diff --staged --quiet; then
                echo "No inflight shard changes"
                exit 0
              fi
              git commit -m "ci: update inflight preview shards [skip ci]"
              push_attempt=1
              until git push origin HEAD:development; do
                if [ "$push_attempt" -ge 5 ]; then
                  echo "Push rejected $push_attempt times; giving up." >&2
                  exit 1
                fi
                push_attempt=$((push_attempt + 1))
                git fetch origin development
                git rebase FETCH_HEAD
              done
      - job: inflight_prune
        displayName: Prune inflight preview shards
        condition: eq(variables['Build.SourceBranch'], 'refs/heads/development')
        steps:
          - checkout: self
            persistCredentials: true
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install "opentide==$OPENTIDE_VERSION"
            displayName: Install opentide
          - script: |
              set -e
              export OPENTIDE_REPO_ROOT="$BUILD_SOURCESDIRECTORY"
              opentide generate inflight prune
              git config user.email "azure-pipelines@opentide.local"
              git config user.name "azure-pipelines"
              mkdir -p .opentide/inflight
              git add .opentide/inflight/
              if git diff --staged --quiet; then
                echo "No inflight prune changes"
                exit 0
              fi
              git commit -m "ci: prune inflight preview shards [skip ci]"
              push_attempt=1
              until git push origin HEAD:development; do
                if [ "$push_attempt" -ge 5 ]; then
                  echo "Push rejected $push_attempt times; giving up." >&2
                  exit 1
                fi
                push_attempt=$((push_attempt + 1))
                git fetch origin development
                git rebase FETCH_HEAD
              done
      - job: deploy_production
        displayName: Deploy Production
        condition: eq(variables['Build.SourceBranch'], 'refs/heads/development')
        steps:
          - checkout: self
            persistCredentials: true
            fetchDepth: 0
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install "opentide==$OPENTIDE_VERSION"
            displayName: Install opentide
          - script: |
              set -e
              commit="${SYSTEM_PULLREQUEST_SOURCECOMMITID:-${BUILD_SOURCEVERSION:-}}"; if [ -n "$commit" ] && git log -1 --format=%B "$commit" 2>/dev/null | grep -qF '[skip deploy]'; then echo "[skip deploy] or the skip-deploy label: no live query check, deploy or share in this pipeline."; exit 0; fi
              git config user.email "azure-pipelines@opentide.local"
              git config user.name "azure-pipelines"
              git fetch origin development
              rm -rf -- .opentide/states/deployment
              git rm -r -q --cached --ignore-unmatch -- .opentide/states/deployment
              if git cat-file -e "FETCH_HEAD:.opentide/states/deployment" 2>/dev/null; then
                git checkout FETCH_HEAD -- .opentide/states/deployment
              fi
              if git diff --cached --quiet -- .opentide/states/deployment; then
                state_base=$(git rev-parse HEAD)
              else
                state_base=$(git commit-tree "$(git write-tree)" -p HEAD -m "opentide: deployment state of the default branch")
              fi
              echo "$state_base" > "$(git rev-parse --git-path opentide-state-base)"
              opentide deploy --dry-run --strategy RELEASE
              echo "##vso[task.setvariable variable=OPENTIDE_DEPLOY_STARTED]true"
              opentide deploy --strategy RELEASE --skip-unconfigured
          - script: |
              set -e
              git config user.email "azure-pipelines@opentide.local"
              git config user.name "azure-pipelines"
              if [ -f "$(git rev-parse --git-path opentide-state-base)" ]; then
                git reset -q --soft "$(cat "$(git rev-parse --git-path opentide-state-base)")"
              fi
              writeback_status=0
              if [ -d .opentide/states/deployment ] || [ -n "$(git ls-files -- .opentide/states/deployment)" ]; then
                git add -A -- .opentide/states/deployment
              fi
              git diff -z --name-only -- 'Objects/Detection Rules' > "$(git rev-parse --git-path opentide-rule-files)"
              set --
              while IFS= read -r -d '' rule_file; do
                set -- "$@" --file "$rule_file"
              done < "$(git rev-parse --git-path opentide-rule-files)"
              if [ "$#" -gt 0 ]; then
                if opentide validate --strict "$@"; then
                  git add -u -- 'Objects/Detection Rules'
                else
                  echo "opentide validate --strict failed on the deployed rule files: committing the deployment state only, not the rule files." >&2
                  writeback_status=1
                fi
              fi
              if git diff --staged --quiet; then
                echo "No deployment write-backs to commit"
                exit "$writeback_status"
              fi
              git commit -q -m "ci: record production deployment [skip ci]"
              git reset -q --hard HEAD
              state_commit=$(git rev-parse HEAD)
              state_published=0
              # shellcheck disable=SC2317,SC2329 # run by the EXIT trap below
              opentide_state_exit() {
                exit_status=$?
                if [ "$state_published" -ne 1 ]; then
                  echo "The deployment state did not reach the default branch. The vendor ids this run recorded are printed below and pushed to refs/opentide/deployment-state/<commit>; record them before the next deploy." >&2
                  git --no-pager diff "$state_commit^" "$state_commit" -- .opentide/states/deployment >&2 || true
                  git push origin "$state_commit:refs/opentide/deployment-state/$state_commit" >&2 || true
                fi
                exit "$exit_status"
              }
              trap opentide_state_exit EXIT
              push_attempt=1
              until git push origin HEAD:development; do
                if [ "$push_attempt" -ge 5 ]; then
                  echo "Push rejected $push_attempt times; giving up." >&2
                  exit 1
                fi
                push_attempt=$((push_attempt + 1))
                git fetch origin development
                if ! git rebase -q --onto FETCH_HEAD HEAD~1; then
                  git rebase --abort
                  echo "The rule write-back conflicts with the default branch: pushing the deployment state alone so no vendor id is lost." >&2
                  writeback_status=1
                  git reset -q --hard FETCH_HEAD
                  if ! opentide deploy replay-state "$state_commit"; then
                    echo "Could not replay the deployment state onto the default branch." >&2
                    exit 1
                  fi
                  if [ -d .opentide/states/deployment ] || [ -n "$(git ls-files -- .opentide/states/deployment)" ]; then
                    git add -A -- .opentide/states/deployment
                  fi
                  if git diff --staged --quiet; then
                    echo "The default branch already holds this deployment state." >&2
                    state_published=1
                    exit 1
                  fi
                  git commit -q -m "ci: record production deployment [skip ci]"
                  state_commit=$(git rev-parse HEAD)
                fi
              done
              state_published=1
              exit "$writeback_status"
            displayName: Commit deployment write-backs
            condition: and(always(), eq(variables['OPENTIDE_DEPLOY_STARTED'], 'true'))

  - stage: Document
    displayName: Document
    dependsOn: Generate
    condition: eq(variables['Build.SourceBranch'], 'refs/heads/development')
    jobs:
      - job: document
        displayName: Generate documentation
        steps:
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.12'
          - script: pip install "opentide==$OPENTIDE_VERSION"
            displayName: Install opentide
          - script: |
              set -e
              opentide generate docs --output docs
          - task: PublishBuildArtifacts@1
            displayName: Publish documentation
            inputs:
              PathtoPublish: "$(Build.SourcesDirectory)/docs"
              ArtifactName: opentide-docs
