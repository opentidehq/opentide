            {
              "id": "graylog_schedule",
              "name": "GraylogSchedule",
              "helpUri": "https://opentide.org/docs/cli/diagnostics#graylog_schedule",
              "shortDescription": {
                "text": "A Graylog block's schedule is invalid."
