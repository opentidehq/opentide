              "id": "graylog_version_unsupported",
              "name": "GraylogVersionUnsupported",
              "helpUri": "https://opentide.org/docs/cli/diagnostics#graylog_version_unsupported",
              "shortDescription": {
                "text": "A Graylog tenant runs a version opentide does not deploy to."
