              "id": "google_secops_create_no_id",
              "name": "GoogleSecopsCreateNoId",
              "helpUri": "https://opentide.org/docs/cli/diagnostics#google_secops_create_no_id",
              "shortDescription": {
                "text": "A Google SecOps create answered without a rule id."
