              "id": "google_secops_live_frequency_unavailable",
              "name": "GoogleSecopsLiveFrequencyUnavailable",
              "helpUri": "https://opentide.org/docs/cli/diagnostics#google_secops_live_frequency_unavailable",
              "shortDescription": {
                "text": "A Google SecOps rule with two or more event variables asks for `run_frequency: LIVE`."
