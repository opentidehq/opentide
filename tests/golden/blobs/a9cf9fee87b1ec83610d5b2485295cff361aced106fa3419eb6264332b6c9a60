            {
              "id": "ecs_type_mismatch",
              "name": "EcsTypeMismatch",
              "helpUri": "https://opentide.org/docs/cli/diagnostics#ecs_type_mismatch",
              "shortDescription": {
                "text": "The operation cannot apply to the field's type, from ECS or from the columns visibility.toml declares for the index."
              },
              "fullDescription": {
                "text": "The operation cannot apply to the field's type, from ECS or from the columns visibility.toml declares for the index."
              },
