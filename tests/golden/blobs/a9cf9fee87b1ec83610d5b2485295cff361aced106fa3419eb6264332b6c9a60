            },
            {
              "id": "google_secops_rule_recreated",
              "name": "GoogleSecopsRuleRecreated",
              "helpUri": "https://opentide.org/docs/cli/diagnostics#google_secops_rule_recreated",
              "shortDescription": {
                "text": "The Google SecOps rule a binding names no longer exists, so deploy created it again."
