{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "GenericTenant": {
      "additionalProperties": false,
      "description": "`[[tenants]]` of a platform opentide has no model for.",
      "properties": {
        "name": {
          "description": "Tenant name a rule's platform block may list.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "What the tenant is.",
          "title": "Description",
          "type": "string"
        },
        "strategies": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "PREVIEW",
                  "RELEASE"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "enum": [
                "PREVIEW",
                "RELEASE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Status strategies the tenant accepts (PREVIEW, RELEASE). Omit for both.",
          "title": "Strategies"
        },
        "manual": {
          "default": false,
          "description": "Only rules whose platform block lists this tenant reach it.",
          "title": "Manual",
          "type": "boolean"
        },
        "setup": {
          "$ref": "#/$defs/GenericTenantSetup",
          "description": "Connection settings."
        },
        "parameters": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Values rules can select from.",
          "title": "Parameters"
        }
      },
      "required": [
        "name"
      ],
      "title": "GenericTenant",
      "type": "object"
    },
    "GenericTenantSetup": {
      "additionalProperties": true,
      "description": "`[tenants.setup]` of a platform opentide has no model for.",
      "properties": {
        "ssl": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "default": true,
          "description": "Verify the tenant's TLS certificate. A $NAME placeholder is allowed.",
          "title": "Ssl"
        }
      },
      "title": "GenericTenantSetup",
      "type": "object"
    },
    "LegacyTideIdentity": {
      "additionalProperties": true,
      "description": "`[tide]`: CoreTIDE-era identity table. `identifier` keys the file.",
      "properties": {
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platform identifier, read when [platform] has none.",
          "title": "Identifier"
        }
      },
      "title": "LegacyTideIdentity",
      "type": "object"
    },
    "Modifier": {
      "additionalProperties": false,
      "description": "`[[modifiers]]`: rule values rewritten at deploy time when the conditions match.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Modifier name.",
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the modifier is for.",
          "title": "Description"
        },
        "conditions": {
          "$ref": "#/$defs/ModifierConditions",
          "description": "When the modifier applies."
        },
        "modifications": {
          "additionalProperties": true,
          "description": "Rule values to set, keyed by dotted platform field path.",
          "title": "Modifications",
          "type": "object"
        }
      },
      "required": [
        "conditions",
        "modifications"
      ],
      "title": "Modifier",
      "type": "object"
    },
    "ModifierConditions": {
      "additionalProperties": false,
      "description": "`[modifiers.conditions]`: which rules a modifier applies to.",
      "properties": {
        "status": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply to rules in one of these deployment statuses.",
          "title": "Status"
        },
        "flags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply to rules carrying one of these flags.",
          "title": "Flags"
        },
        "tenants": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply when deploying to one of these tenants.",
          "title": "Tenants"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply to every rule, as platform defaults.",
          "title": "Default"
        }
      },
      "title": "ModifierConditions",
      "type": "object"
    },
    "PlatformIdentity": {
      "additionalProperties": false,
      "description": "`[platform]`: whether the platform is enabled, and how it is named.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Load and deploy to this platform.",
          "title": "Enabled",
          "type": "boolean"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platform identifier (for example sentinel). Matches the file name stem.",
          "title": "Identifier"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Display name of the platform.",
          "title": "Name"
        },
        "subschema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Title of the platform's rule sub-schema.",
          "title": "Subschema"
        },
        "description": {
          "default": "",
          "description": "What the platform is.",
          "title": "Description",
          "type": "string"
        },
        "flags": {
          "description": "Flags a modifier condition can match.",
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "title": "PlatformIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Merged `platforms/<id>.toml` for a platform opentide has no model for.",
  "properties": {
    "platform": {
      "$ref": "#/$defs/PlatformIdentity",
      "description": "Platform identity."
    },
    "tide": {
      "anyOf": [
        {
          "$ref": "#/$defs/LegacyTideIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "CoreTIDE-era identity table."
    },
    "modifiers": {
      "description": "Deploy-time rule modifiers.",
      "items": {
        "$ref": "#/$defs/Modifier"
      },
      "title": "Modifiers",
      "type": "array"
    },
    "tenants": {
      "description": "Tenants.",
      "items": {
        "$ref": "#/$defs/GenericTenant"
      },
      "title": "Tenants",
      "type": "array"
    }
  },
  "title": "platforms/<id>.toml",
  "type": "object"
}
