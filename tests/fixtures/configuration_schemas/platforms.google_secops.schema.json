{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "GoogleSecopsSetup": {
      "additionalProperties": false,
      "description": "`[tenants.setup]` for Google Security Operations.",
      "properties": {
        "ssl": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "description": "Environment variable placeholder ($NAME), resolved when the tenant loads.",
              "pattern": "^\\$",
              "type": "string"
            },
            {
              "description": "A boolean written as a word: true/false, yes/no, on/off, 1/0.",
              "pattern": "^\\s*([tT][rR][uU][eE]|[yY][eE][sS]|[oO][nN]|1|[fF][aA][lL][sS][eE]|[nN][oO]|[oO][fF][fF]|0)\\s*$",
              "type": "string"
            }
          ],
          "default": true,
          "description": "Verify the tenant's TLS certificate: a boolean, true/false, yes/no, on/off, 1/0, or a $NAME placeholder.",
          "title": "Ssl"
        },
        "project": {
          "description": "The Google Cloud project bound to the SecOps instance, id or number.",
          "minLength": 1,
          "title": "Project",
          "type": "string"
        },
        "location": {
          "description": "The instance's region: us, eu, europe, or a Google Cloud region such as europe-west2.",
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "instance": {
          "description": "The SecOps customer id (a UUID).",
          "minLength": 1,
          "title": "Instance",
          "type": "string"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The regional service endpoint. Default: https://<location>-chronicle.googleapis.com.",
          "title": "Endpoint"
        },
        "credentials": {
          "anyOf": [
            {
              "description": "Environment variable placeholder ($NAME), resolved when the tenant loads.",
              "pattern": "^\\$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A $NAME placeholder for a service-account key, as a JSON document or a path to one. Without it, Application Default Credentials (workload identity, gcloud auth).",
          "title": "Credentials"
        },
        "data_access_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A data access scope id, sent as scope on create and update.",
          "title": "Data Access Scope"
        },
        "deletion": {
          "default": "archive",
          "description": "DELETION: archive the rule (keeps its detections and the binding), or delete it without force.",
          "enum": [
            "archive",
            "delete"
          ],
          "title": "Deletion",
          "type": "string"
        }
      },
      "required": [
        "project",
        "location",
        "instance"
      ],
      "title": "GoogleSecopsSetup",
      "type": "object"
    },
    "GoogleSecopsTenant": {
      "additionalProperties": false,
      "description": "`[[tenants]]` for Google Security Operations.",
      "properties": {
        "name": {
          "description": "Tenant name a rule's platform block may list.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "What the tenant is.",
          "title": "Description",
          "type": "string"
        },
        "strategies": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "enum": [
                      "PREVIEW",
                      "RELEASE"
                    ]
                  },
                  {
                    "pattern": "^\\s*([pP][rR][eE][vV][iI][eE][wW]|[rR][eE][lL][eE][aA][sS][eE])\\s*$"
                  }
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "anyOf": [
                {
                  "enum": [
                    "PREVIEW",
                    "RELEASE"
                  ]
                },
                {
                  "pattern": "^\\s*([pP][rR][eE][vV][iI][eE][wW]|[rR][eE][lL][eE][aA][sS][eE])\\s*$"
                }
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Status strategies the tenant accepts (PREVIEW, RELEASE). Omit for both.",
          "title": "Strategies"
        },
        "manual": {
          "default": false,
          "description": "Only rules whose platform block lists this tenant reach it.",
          "title": "Manual",
          "type": "boolean"
        },
        "setup": {
          "$ref": "#/$defs/GoogleSecopsSetup",
          "description": "Connection settings."
        }
      },
      "required": [
        "name",
        "setup"
      ],
      "title": "GoogleSecopsTenant",
      "type": "object"
    },
    "Modifier": {
      "additionalProperties": false,
      "description": "`[[modifiers]]`: rule values rewritten at deploy time when the conditions match.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Modifier name.",
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the modifier is for.",
          "title": "Description"
        },
        "conditions": {
          "$ref": "#/$defs/ModifierConditions",
          "description": "When the modifier applies."
        },
        "modifications": {
          "additionalProperties": true,
          "description": "Rule values to set, keyed by dotted platform field path.",
          "title": "Modifications",
          "type": "object"
        }
      },
      "required": [
        "conditions",
        "modifications"
      ],
      "title": "Modifier",
      "type": "object"
    },
    "ModifierConditions": {
      "additionalProperties": false,
      "description": "`[modifiers.conditions]`: which rules a modifier applies to.",
      "properties": {
        "status": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply to rules in one of these deployment statuses.",
          "title": "Status"
        },
        "flags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply to rules carrying one of these flags.",
          "title": "Flags"
        },
        "tenants": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply when deploying to one of these tenants.",
          "title": "Tenants"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply to every rule, as platform defaults.",
          "title": "Default"
        }
      },
      "title": "ModifierConditions",
      "type": "object"
    },
    "PlatformIdentity": {
      "additionalProperties": false,
      "description": "`[platform]`: whether the platform is enabled, and how it is named.\n\nThe file name stem (`platforms/splunk.toml`) identifies the platform.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Load and deploy to this platform.",
          "title": "Enabled",
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Display name of the platform.",
          "title": "Name"
        },
        "description": {
          "default": "",
          "description": "What the platform is.",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "PlatformIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Merged `platforms/google_secops.toml`.",
  "properties": {
    "platform": {
      "$ref": "#/$defs/PlatformIdentity",
      "description": "Platform identity."
    },
    "modifiers": {
      "description": "Deploy-time rule modifiers.",
      "items": {
        "$ref": "#/$defs/Modifier"
      },
      "title": "Modifiers",
      "type": "array"
    },
    "tenants": {
      "description": "Google SecOps instances.",
      "items": {
        "$ref": "#/$defs/GoogleSecopsTenant"
      },
      "title": "Tenants",
      "type": "array"
    }
  },
  "title": "platforms/google_secops.toml",
  "type": "object"
}
