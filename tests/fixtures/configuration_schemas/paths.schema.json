{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Artifacts": {
      "additionalProperties": false,
      "description": "`[artifacts]`: file names of everything opentide generates.",
      "properties": {
        "schemas": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchemaArtifacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON Schema files."
        },
        "templates": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateArtifacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Template files."
        },
        "exports": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExportArtifacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Export files."
        }
      },
      "title": "Artifacts",
      "type": "object"
    },
    "DocsPaths": {
      "additionalProperties": false,
      "description": "`[paths.docs]`: where `opentide generate docs` writes each family.",
      "properties": {
        "root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Documentation root. Path relative to the workspace root.",
          "title": "Root"
        },
        "rules": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule pages. Path relative to the workspace root.",
          "title": "Rules"
        },
        "objectives": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Objective pages. Path relative to the workspace root.",
          "title": "Objectives"
        },
        "threats": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Threat pages. Path relative to the workspace root.",
          "title": "Threats"
        }
      },
      "title": "DocsPaths",
      "type": "object"
    },
    "ExportArtifacts": {
      "additionalProperties": false,
      "description": "`[artifacts.exports]`: file names of the generated exports.",
      "properties": {
        "revisions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Revisions export file name.",
          "title": "Revisions"
        },
        "objects": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Objects export file name.",
          "title": "Objects"
        },
        "attack_layer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ATT&CK Navigator layer file name.",
          "title": "Attack Layer"
        }
      },
      "title": "ExportArtifacts",
      "type": "object"
    },
    "ExportPaths": {
      "additionalProperties": false,
      "description": "`[paths.exports]`: where `opentide generate exports` writes.",
      "properties": {
        "root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exports folder. Path relative to the workspace root.",
          "title": "Root"
        }
      },
      "title": "ExportPaths",
      "type": "object"
    },
    "ObjectPaths": {
      "additionalProperties": false,
      "description": "`[paths.objects]`: where each object family is authored.",
      "properties": {
        "threat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Threat vector folder. Path relative to the workspace root.",
          "title": "Threat"
        },
        "objective": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detection objective folder. Path relative to the workspace root.",
          "title": "Objective"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detection rule folder. Path relative to the workspace root.",
          "title": "Rule"
        },
        "snippet_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Generated VS Code snippet file. Path relative to the workspace root.",
          "title": "Snippet File"
        }
      },
      "title": "ObjectPaths",
      "type": "object"
    },
    "OpentidePaths": {
      "additionalProperties": false,
      "description": "`[paths.opentide]`: the `.opentide/` folder and its generated artifacts.",
      "properties": {
        "root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The .opentide folder. Path relative to the workspace root.",
          "title": "Root"
        },
        "schemas": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Generated JSON Schemas. Path relative to the workspace root.",
          "title": "Schemas"
        },
        "templates": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Generated templates. Path relative to the workspace root.",
          "title": "Templates"
        }
      },
      "title": "OpentidePaths",
      "type": "object"
    },
    "SchemaArtifacts": {
      "additionalProperties": false,
      "description": "`[artifacts.schemas]`: file names of the generated JSON Schemas.",
      "properties": {
        "threat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Threat vector schema file name.",
          "title": "Threat"
        },
        "objective": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detection objective schema file name.",
          "title": "Objective"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detection rule schema file name.",
          "title": "Rule"
        },
        "visibility": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "visibility.toml schema file name.",
          "title": "Visibility"
        },
        "router": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Object router schema file name.",
          "title": "Router"
        }
      },
      "title": "SchemaArtifacts",
      "type": "object"
    },
    "TemplateArtifacts": {
      "additionalProperties": false,
      "description": "`[artifacts.templates]`: file names of the generated templates.",
      "properties": {
        "threat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Threat vector template file name.",
          "title": "Threat"
        },
        "objective": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detection objective template file name.",
          "title": "Objective"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detection rule template file name.",
          "title": "Rule"
        }
      },
      "title": "TemplateArtifacts",
      "type": "object"
    },
    "WorkspacePaths": {
      "additionalProperties": false,
      "description": "`[paths]`: workspace directories. Every value is relative to the workspace root.",
      "properties": {
        "opentide": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpentidePaths"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The .opentide folder."
        },
        "objects": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectPaths"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Object folders."
        },
        "exports": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExportPaths"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exports folder."
        },
        "docs": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocsPaths"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Documentation folders."
        }
      },
      "title": "WorkspacePaths",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Merged `paths.toml`: workspace layout and artifact names.",
  "properties": {
    "objects": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "threat",
              "objective",
              "rule"
            ],
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Object families the workspace holds.",
      "title": "Objects"
    },
    "paths": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkspacePaths"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Workspace directories."
    },
    "artifacts": {
      "anyOf": [
        {
          "$ref": "#/$defs/Artifacts"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Generated file names."
    },
    "metaschemas": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model family of each object family, keyed by family.",
      "title": "Metaschemas"
    }
  },
  "title": "paths.toml",
  "type": "object"
}
