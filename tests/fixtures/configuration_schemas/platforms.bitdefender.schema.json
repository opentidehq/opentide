{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BitdefenderEndpointTag": {
      "additionalProperties": false,
      "description": "An `endpoint_tags` entry: the GravityZone tag and the company that owns it.",
      "properties": {
        "tag_id": {
          "description": "GravityZone tag id, 24 hex.",
          "pattern": "^[0-9a-f]{24}$",
          "title": "Tag Id",
          "type": "string"
        },
        "company_id": {
          "description": "Company id of the tag, 24 hex.",
          "pattern": "^[0-9a-f]{24}$",
          "title": "Company Id",
          "type": "string"
        }
      },
      "required": [
        "tag_id",
        "company_id"
      ],
      "title": "BitdefenderEndpointTag",
      "type": "object"
    },
    "BitdefenderSetup": {
      "additionalProperties": false,
      "description": "`[tenants.setup]` for Bitdefender GravityZone.",
      "properties": {
        "ssl": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "description": "Environment variable placeholder ($NAME), resolved when the tenant loads.",
              "pattern": "^\\$",
              "type": "string"
            },
            {
              "description": "A boolean written as a word: true/false, yes/no, on/off, 1/0.",
              "pattern": "^\\s*([tT][rR][uU][eE]|[yY][eE][sS]|[oO][nN]|1|[fF][aA][lL][sS][eE]|[nN][oO]|[oO][fF][fF]|0)\\s*$",
              "type": "string"
            }
          ],
          "default": true,
          "description": "Verify the tenant's TLS certificate: a boolean, true/false, yes/no, on/off, 1/0, or a $NAME placeholder.",
          "title": "Ssl"
        },
        "url": {
          "description": "Control Center API Access URL, ending in /api. Calls go to <url>/v1.0/jsonrpc/incidents.",
          "title": "Url",
          "type": "string"
        },
        "api_key": {
          "description": "GravityZone API key with the Incidents API. Must be a $NAME placeholder.",
          "pattern": "^\\$",
          "title": "Api Key",
          "type": "string"
        },
        "key_type": {
          "default": "personal",
          "description": "personal: HTTP Basic with the key as user name; service: X-API-Key header.",
          "enum": [
            "personal",
            "service"
          ],
          "title": "Key Type",
          "type": "string"
        },
        "company_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Partner tenants: the company that owns created rules.",
          "title": "Company Id"
        },
        "automatic_actions": {
          "default": true,
          "description": "false for subscriptions without automatic actions.",
          "title": "Automatic Actions",
          "type": "boolean"
        },
        "targets": {
          "anyOf": [
            {
              "$ref": "#/$defs/BitdefenderTenantTargets"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default targets for blocks that set none."
        },
        "endpoint_tags": {
          "additionalProperties": {
            "$ref": "#/$defs/BitdefenderEndpointTag"
          },
          "description": "Alias to {tag_id, company_id}.",
          "title": "Endpoint Tags",
          "type": "object"
        },
        "companies": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{24}$",
            "type": "string"
          },
          "description": "Alias to company id.",
          "title": "Companies",
          "type": "object"
        },
        "tags": {
          "description": "Tags added to every rule.",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "url",
        "api_key"
      ],
      "title": "BitdefenderSetup",
      "type": "object"
    },
    "BitdefenderTenant": {
      "additionalProperties": false,
      "description": "`[[tenants]]` for Bitdefender GravityZone.",
      "properties": {
        "name": {
          "description": "Tenant name a rule's platform block may list.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "What the tenant is.",
          "title": "Description",
          "type": "string"
        },
        "strategies": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "enum": [
                      "PREVIEW",
                      "RELEASE"
                    ]
                  },
                  {
                    "pattern": "^\\s*([pP][rR][eE][vV][iI][eE][wW]|[rR][eE][lL][eE][aA][sS][eE])\\s*$"
                  }
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "anyOf": [
                {
                  "enum": [
                    "PREVIEW",
                    "RELEASE"
                  ]
                },
                {
                  "pattern": "^\\s*([pP][rR][eE][vV][iI][eE][wW]|[rR][eE][lL][eE][aA][sS][eE])\\s*$"
                }
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Status strategies the tenant accepts (PREVIEW, RELEASE). Omit for both.",
          "title": "Strategies"
        },
        "manual": {
          "default": false,
          "description": "Only rules whose platform block lists this tenant reach it.",
          "title": "Manual",
          "type": "boolean"
        },
        "setup": {
          "$ref": "#/$defs/BitdefenderSetup",
          "description": "Connection settings."
        }
      },
      "required": [
        "name",
        "setup"
      ],
      "title": "BitdefenderTenant",
      "type": "object"
    },
    "BitdefenderTenantTargets": {
      "additionalProperties": false,
      "description": "`[tenants.setup.targets]`: default targets for blocks that set none.",
      "properties": {
        "endpoint_tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Aliases from the tenant's endpoint_tags table.",
          "title": "Endpoint Tags"
        },
        "companies": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Aliases from the tenant's companies table.",
          "title": "Companies"
        }
      },
      "title": "BitdefenderTenantTargets",
      "type": "object"
    },
    "Modifier": {
      "additionalProperties": false,
      "description": "`[[modifiers]]`: rule values rewritten at deploy time when the conditions match.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Modifier name.",
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the modifier is for.",
          "title": "Description"
        },
        "conditions": {
          "$ref": "#/$defs/ModifierConditions",
          "description": "When the modifier applies."
        },
        "modifications": {
          "additionalProperties": true,
          "description": "Rule values to set, keyed by dotted platform field path.",
          "title": "Modifications",
          "type": "object"
        }
      },
      "required": [
        "conditions",
        "modifications"
      ],
      "title": "Modifier",
      "type": "object"
    },
    "ModifierConditions": {
      "additionalProperties": false,
      "description": "`[modifiers.conditions]`: which rules a modifier applies to.",
      "properties": {
        "status": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply to rules in one of these deployment statuses.",
          "title": "Status"
        },
        "flags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply to rules carrying one of these flags.",
          "title": "Flags"
        },
        "tenants": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply when deploying to one of these tenants.",
          "title": "Tenants"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply to every rule, as platform defaults.",
          "title": "Default"
        }
      },
      "title": "ModifierConditions",
      "type": "object"
    },
    "PlatformIdentity": {
      "additionalProperties": false,
      "description": "`[platform]`: whether the platform is enabled, and how it is named.\n\nThe file name stem (`platforms/splunk.toml`) identifies the platform.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Load and deploy to this platform.",
          "title": "Enabled",
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Display name of the platform.",
          "title": "Name"
        },
        "description": {
          "default": "",
          "description": "What the platform is.",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "PlatformIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Merged `platforms/bitdefender.toml`.",
  "properties": {
    "platform": {
      "$ref": "#/$defs/PlatformIdentity",
      "description": "Platform identity."
    },
    "modifiers": {
      "description": "Deploy-time rule modifiers.",
      "items": {
        "$ref": "#/$defs/Modifier"
      },
      "title": "Modifiers",
      "type": "array"
    },
    "tenants": {
      "description": "GravityZone tenants.",
      "items": {
        "$ref": "#/$defs/BitdefenderTenant"
      },
      "title": "Tenants",
      "type": "array"
    }
  },
  "title": "platforms/bitdefender.toml",
  "type": "object"
}
