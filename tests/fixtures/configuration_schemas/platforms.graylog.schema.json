{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "GraylogSetup": {
      "additionalProperties": false,
      "description": "`[tenants.setup]` for Graylog.",
      "properties": {
        "ssl": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "description": "Environment variable placeholder ($NAME), resolved when the tenant loads.",
              "pattern": "^\\$",
              "type": "string"
            },
            {
              "description": "A boolean written as a word: true/false, yes/no, on/off, 1/0.",
              "pattern": "^\\s*([tT][rR][uU][eE]|[yY][eE][sS]|[oO][nN]|1|[fF][aA][lL][sS][eE]|[nN][oO]|[oO][fF][fF]|0)\\s*$",
              "type": "string"
            }
          ],
          "default": true,
          "description": "Verify the tenant's TLS certificate: a boolean, true/false, yes/no, on/off, 1/0, or a $NAME placeholder.",
          "title": "Ssl"
        },
        "url": {
          "description": "The Graylog web interface's base URL. Calls go to <url>/api/....",
          "title": "Url",
          "type": "string"
        },
        "token": {
          "description": "A Graylog access token, sent as HTTP Basic <token>:token. Must be a $NAME placeholder.",
          "pattern": "^\\$",
          "title": "Token",
          "type": "string"
        },
        "allow_leading_wildcard": {
          "default": false,
          "description": "Mirrors the server's allow_leading_wildcard_searches.",
          "title": "Allow Leading Wildcard",
          "type": "boolean"
        },
        "streams": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "items": {
                "pattern": "\\S",
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "Default stream aliases for blocks that set no streams.",
          "title": "Streams"
        },
        "stream_ids": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{24}$",
            "type": "string"
          },
          "description": "Alias to stream id, 24 hex.",
          "title": "Stream Ids",
          "type": "object"
        },
        "notification_ids": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{24}$",
            "type": "string"
          },
          "description": "Alias to notification id, 24 hex.",
          "title": "Notification Ids",
          "type": "object"
        },
        "tags": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "items": {
                "pattern": "\\S",
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "Tags added to every definition on this tenant (7.2+).",
          "title": "Tags"
        }
      },
      "required": [
        "url",
        "token"
      ],
      "title": "GraylogSetup",
      "type": "object"
    },
    "GraylogTenant": {
      "additionalProperties": false,
      "description": "`[[tenants]]` for Graylog.",
      "properties": {
        "name": {
          "description": "Tenant name a rule's platform block may list.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "What the tenant is.",
          "title": "Description",
          "type": "string"
        },
        "strategies": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "enum": [
                      "PREVIEW",
                      "RELEASE"
                    ]
                  },
                  {
                    "pattern": "^\\s*([pP][rR][eE][vV][iI][eE][wW]|[rR][eE][lL][eE][aA][sS][eE])\\s*$"
                  }
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "anyOf": [
                {
                  "enum": [
                    "PREVIEW",
                    "RELEASE"
                  ]
                },
                {
                  "pattern": "^\\s*([pP][rR][eE][vV][iI][eE][wW]|[rR][eE][lL][eE][aA][sS][eE])\\s*$"
                }
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Status strategies the tenant accepts (PREVIEW, RELEASE). Omit for both.",
          "title": "Strategies"
        },
        "manual": {
          "default": false,
          "description": "Only rules whose platform block lists this tenant reach it.",
          "title": "Manual",
          "type": "boolean"
        },
        "setup": {
          "$ref": "#/$defs/GraylogSetup",
          "description": "Connection settings."
        }
      },
      "required": [
        "name",
        "setup"
      ],
      "title": "GraylogTenant",
      "type": "object"
    },
    "Modifier": {
      "additionalProperties": false,
      "description": "`[[modifiers]]`: rule values rewritten at deploy time when the conditions match.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Modifier name.",
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the modifier is for.",
          "title": "Description"
        },
        "conditions": {
          "$ref": "#/$defs/ModifierConditions",
          "description": "When the modifier applies."
        },
        "modifications": {
          "additionalProperties": true,
          "description": "Rule values to set, keyed by dotted platform field path.",
          "title": "Modifications",
          "type": "object"
        }
      },
      "required": [
        "conditions",
        "modifications"
      ],
      "title": "Modifier",
      "type": "object"
    },
    "ModifierConditions": {
      "additionalProperties": false,
      "description": "`[modifiers.conditions]`: which rules a modifier applies to.",
      "properties": {
        "status": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply to rules in one of these deployment statuses.",
          "title": "Status"
        },
        "flags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply to rules carrying one of these flags.",
          "title": "Flags"
        },
        "tenants": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply when deploying to one of these tenants.",
          "title": "Tenants"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply to every rule, as platform defaults.",
          "title": "Default"
        }
      },
      "title": "ModifierConditions",
      "type": "object"
    },
    "PlatformIdentity": {
      "additionalProperties": false,
      "description": "`[platform]`: whether the platform is enabled, and how it is named.\n\nThe file name stem (`platforms/splunk.toml`) identifies the platform.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Load and deploy to this platform.",
          "title": "Enabled",
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Display name of the platform.",
          "title": "Name"
        },
        "description": {
          "default": "",
          "description": "What the platform is.",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "PlatformIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Merged `platforms/graylog.toml`.",
  "properties": {
    "platform": {
      "$ref": "#/$defs/PlatformIdentity",
      "description": "Platform identity."
    },
    "modifiers": {
      "description": "Deploy-time rule modifiers.",
      "items": {
        "$ref": "#/$defs/Modifier"
      },
      "title": "Modifiers",
      "type": "array"
    },
    "tenants": {
      "description": "Graylog tenants.",
      "items": {
        "$ref": "#/$defs/GraylogTenant"
      },
      "title": "Tenants",
      "type": "array"
    }
  },
  "title": "platforms/graylog.toml",
  "type": "object"
}
