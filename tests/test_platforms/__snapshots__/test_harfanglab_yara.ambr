# name: test_the_yara_payload[signature]
  dict({
    'content': '''
      import "pe"
      
      private rule MZ_Header {
        condition:
          uint16(0) == 0x5A4D
      }
      
      rule Loader_Stage1 : loader {
        meta:
          description = "Stage-1 loader with an encrypted config blob"
          context = "file,memory"
        strings:
          $cfg = { 43 46 47 21 [4-16] 00 01 }
          $mutex = "Global\\qx-7731" ascii wide
        condition:
          MZ_Header and pe.number_of_sections > 3 and all of them
      }
  
    ''',
    'global_state': 'block',
    'hl_status': 'experimental',
    'name': 'HarfangLab YARA signature block',
    'rule_confidence_override': 'moderate',
    'rule_level_override': 'high',
    'source_id': 'source-1',
  })
