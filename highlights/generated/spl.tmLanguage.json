{
  "name": "opentide spl",
  "opentideHighlightSpec": "0.3.2",
  "patterns": [
    {
      "comment": "capture:comment",
      "match": "```[^`]*```",
      "name": "comment.line.opentide"
    },
    {
      "comment": "capture:macro",
      "match": "`[A-Za-z_][A-Za-z0-9_]*(?:\\([^)`]*\\))?`",
      "name": "entity.name.function.preprocessor.opentide"
    },
    {
      "comment": "capture:string",
      "match": "\"(\\\\.|[^\"\\\\])*\"|'(\\\\.|[^'\\\\])*'",
      "name": "string.quoted.opentide"
    },
    {
      "comment": "capture:number",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.opentide"
    },
    {
      "comment": "tm_extras:field",
      "match": "(?<![\\w.$@#])[$@#]?[A-Za-z_][\\w.]*(?=\\s*(?i:==|!=|=~|!~|<=|>=|:=|=|<|>|(?i:in)\\b))",
      "name": "variable.other.property.opentide"
    },
    {
      "comment": "capture:function.builtin",
      "match": "(?i)(?<![A-Za-z0-9_])(?:CASE|PREFIX|TERM)(?![A-Za-z0-9_])",
      "name": "support.function.opentide"
    },
    {
      "comment": "capture:keyword",
      "match": "(?i)(?<![A-Za-z0-9_])(?:allow_old_summaries|append|as|bin|by|chart|consecutive|convert|d|datamodel|dedup|desc|eval|eventstats|extract|fields|fillnull|fillnull_value|foreach|from|geostats|head|in|inputlookup|join|keepempty|keepevents|lookup|makemv|makeresults|map|metadata|mvexpand|notin|output|outputlookup|outputnew|over|prestats|rare|regex|rename|rest|reverse|rex|search|sichart|sistats|sitimechart|sort|sortby|spath|stats|strcat|streamstats|summariesonly|table|tail|timechart|tojson|top|transaction|tstats|union|where)(?![A-Za-z0-9_])",
      "name": "keyword.control.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "(?i)(?<![A-Za-z0-9_])(?:AND|IN|LIKE|NOT|OR|and|like|not|or)(?![A-Za-z0-9_])",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "<",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "<=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "==",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": ">",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": ">=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator.pipe",
      "match": "\\|",
      "name": "keyword.operator.pipe.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\(",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\)",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\[",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\]",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.delimiter",
      "match": ",",
      "name": "punctuation.delimiter.opentide"
    },
    {
      "comment": "tm_extras:word-operator",
      "match": "(?i)(?<![\\w.])in(?![\\w.])",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "tm_extras:boolean",
      "match": "(?i)(?<![\\w.$@#])(?:true|false)(?![\\w.])",
      "name": "constant.language.boolean.opentide"
    },
    {
      "comment": "tm_extras:call",
      "match": "(?<![\\w.$@#:])[A-Za-z_][\\w.]*(?=\\s*\\()",
      "name": "entity.name.function.opentide"
    },
    {
      "comment": "tm_extras:identifier",
      "match": "(?<![\\w.$@#])[A-Za-z_]\\w*(?![\\w(])",
      "name": "variable.other.opentide"
    }
  ],
  "scopeName": "source.spl"
}