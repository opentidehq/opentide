{
  "name": "OpenTide spl",
  "opentideHighlightSpec": "0.2.0",
  "patterns": [
    {
      "comment": "capture:comment",
      "match": "```[^`]*```",
      "name": "comment.line.opentide"
    },
    {
      "comment": "capture:macro",
      "match": "`[A-Za-z_][A-Za-z0-9_]*(?:\\([^)`]*\\))?`",
      "name": "entity.name.function.macro.opentide"
    },
    {
      "comment": "capture:string",
      "match": "\"(\\\\.|[^\"\\\\])*\"|'(\\\\.|[^'\\\\])*'",
      "name": "string.quoted.opentide"
    },
    {
      "comment": "capture:number",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.opentide"
    },
    {
      "comment": "capture:function.builtin",
      "match": "(?i)(?<![A-Za-z0-9_])(?:CASE|TERM)(?![A-Za-z0-9_])",
      "name": "support.function.opentide"
    },
    {
      "comment": "capture:keyword",
      "match": "(?i)(?<![A-Za-z0-9_])(?:AS|allow_old_summaries|append|as|bin|by|chart|convert|datamodel|dedup|eval|eventstats|extract|fields|fillnull|fillnull_value|foreach|from|head|inputlookup|join|lookup|makemv|makeresults|map|metadata|mvexpand|outputlookup|prestats|rare|regex|rename|rest|reverse|rex|search|sort|spath|stats|strcat|streamstats|summariesonly|table|tail|timechart|top|transaction|tstats|union|where)(?![A-Za-z0-9_])",
      "name": "keyword.control.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "(?i)(?<![A-Za-z0-9_])(?:AND|IN|LIKE|NOT|OR|and|not|or)(?![A-Za-z0-9_])",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "==",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator.pipe",
      "match": "\\|",
      "name": "keyword.operator.pipe.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\(",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\)",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\[",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\]",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.delimiter",
      "match": ",",
      "name": "punctuation.delimiter.opentide"
    }
  ],
  "scopeName": "source.spl"
}