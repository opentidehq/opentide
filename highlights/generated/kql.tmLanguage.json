{
  "name": "OpenTide kql",
  "opentideHighlightSpec": "0.2.0",
  "patterns": [
    {
      "comment": "capture:comment",
      "match": "//.*$|/\\*[\\s\\S]*?\\*/",
      "name": "comment.line.opentide"
    },
    {
      "comment": "capture:string",
      "match": "\"(\\\\.|[^\"\\\\])*\"|'(\\\\.|[^'\\\\])*'",
      "name": "string.quoted.opentide"
    },
    {
      "comment": "capture:number",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.opentide"
    },
    {
      "comment": "capture:error",
      "match": "\\.",
      "name": "invalid.illegal.opentide"
    },
    {
      "comment": "capture:keyword",
      "match": "(?i)(?<![A-Za-z0-9_])(?:and|as|asc|by|consume|datatable|desc|distinct|evaluate|extend|externaldata|facet|filter|find|fork|getschema|graph\\-mark\\-components|graph\\-match|graph\\-shortest\\-paths|graph\\-to\\-table|invoke|join|kind|let|limit|lookup|make\\-graph|make\\-series|mv\\-apply|mv\\-expand|mvexpand|on|order|parse|parse\\-kv|parse\\-where|partition|print|project|project\\-away|project\\-keep|project\\-rename|project\\-reorder|range|reduce|render|sample|sample\\-distinct|scan|search|serialize|sort|summarize|take|top|top\\-hitters|top\\-nested|union|where|with)(?![A-Za-z0-9_])",
      "name": "keyword.control.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "(?i)(?<![A-Za-z0-9_])(?:\\-|between|contains|contains_cs|endswith|endswith_cs|has|has_all|has_any|has_any_ipv4|has_any_ipv4_prefix|has_cs|has_ipv4|has_ipv4_prefix|hasprefix|hasprefix_cs|hassuffix|hassuffix_cs|in|matches|not|or|regex|startswith|startswith_cs)(?![A-Za-z0-9_])",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!between",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!contains",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!contains_cs",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!endswith",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!endswith_cs",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!has",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!has_cs",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!hasprefix",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!hasprefix_cs",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!hassuffix",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!hassuffix_cs",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!in",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!in\\~",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!startswith",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!startswith_cs",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!\\~",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "%",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "\\*",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "\\+",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "/",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "<",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "<=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "<>",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "==",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "=\\~",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": ">",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": ">=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "in\\~",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator.pipe",
      "match": "\\|",
      "name": "keyword.operator.pipe.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\(",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\)",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.delimiter",
      "match": ",",
      "name": "punctuation.delimiter.opentide"
    },
    {
      "comment": "capture:punctuation.delimiter",
      "match": ";",
      "name": "punctuation.delimiter.opentide"
    }
  ],
  "scopeName": "source.kql"
}