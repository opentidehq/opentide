{
  "name": "opentide kuery",
  "opentideHighlightSpec": "0.3.2",
  "patterns": [
    {
      "comment": "capture:string",
      "match": "\"(\\\\.|[^\"\\\\])*\"|'(\\\\.|[^'\\\\])*'",
      "name": "string.quoted.opentide"
    },
    {
      "comment": "capture:number",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.opentide"
    },
    {
      "comment": "tm_extras:field",
      "match": "(?<![\\w.$@#])[$@#]?[A-Za-z_][\\w.]*(?=\\s*(?i:==|!=|=~|!~|<=|>=|:=|=|<|>|:))",
      "name": "variable.other.property.opentide"
    },
    {
      "comment": "tm_extras:logical",
      "match": "(?i)(?<![\\w.])(?:and|or|not)(?![\\w.])",
      "name": "keyword.operator.logical.opentide"
    },
    {
      "comment": "capture:operator",
      "match": ":",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "<",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "<=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": ">",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": ">=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\(",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\)",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\{",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\}",
      "name": "punctuation.bracket.opentide"
    }
  ],
  "scopeName": "source.kuery"
}