{
  "name": "opentide esql",
  "opentideHighlightSpec": "0.2.0",
  "patterns": [
    {
      "comment": "capture:comment",
      "match": "//.*$|/\\*[\\s\\S]*?\\*/",
      "name": "comment.line.opentide"
    },
    {
      "comment": "capture:string",
      "match": "\"(\\\\.|[^\"\\\\])*\"|'(\\\\.|[^'\\\\])*'",
      "name": "string.quoted.opentide"
    },
    {
      "comment": "capture:number",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.opentide"
    },
    {
      "comment": "capture:keyword",
      "match": "(?i)(?<![A-Za-z0-9_])(?:and|as|asc|by|change_point|completion|dedup|dense_vector|desc|dissect|drop|enrich|eval|explain|fillnull|first|fork|from|full|fuse|grok|group|highlight|in|info|inline|inlinestats|ip_location|is|join|keep|key|last|left|like|limit|lookup|metadata|metrics_info|mmr|mv_expand|not|nulls|on|or|promql|registered_domain|rename|rerank|right|rlike|row|sample|score|set|show|sort|stats|ts|ts_collapse|ts_info|uri_parts|user_agent|where|with)(?![A-Za-z0-9_])",
      "name": "keyword.control.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "(?i)(?<![A-Za-z0-9_])(?:\\-)(?![A-Za-z0-9_])",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "!=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "%",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "\\*",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "\\+",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "/",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": ":",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "::",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "<",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "<=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": "==",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": ">",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator",
      "match": ">=",
      "name": "keyword.operator.opentide"
    },
    {
      "comment": "capture:operator.pipe",
      "match": "\\|",
      "name": "keyword.operator.pipe.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\(",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\)",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\[",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\]",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\{",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.bracket",
      "match": "\\}",
      "name": "punctuation.bracket.opentide"
    },
    {
      "comment": "capture:punctuation.delimiter",
      "match": ",",
      "name": "punctuation.delimiter.opentide"
    },
    {
      "comment": "capture:punctuation.delimiter",
      "match": "\\.",
      "name": "punctuation.delimiter.opentide"
    },
    {
      "comment": "capture:punctuation.delimiter",
      "match": ";",
      "name": "punctuation.delimiter.opentide"
    }
  ],
  "scopeName": "source.esql"
}