            }
          },
          "comment": "configurations.{sentinel,defender_for_endpoint}: kql queries (#171)",
          "end": "^(?!\\1\\s+\\S|\\s*$)",
          "patterns": [
            {
              "begin": "^(\\s+)(query)\\s*:\\s*[|>][-+0-9]*\\s*(?:#.*)?$",
              "beginCaptures": {
                "2": {
                  "name": "variable.other.property.tide"
                }
              },
              "contentName": "meta.embedded.block.kql",
              "end": "^(?!\\1\\s+\\S|\\s*$)",
              "patterns": [
                {
                  "include": "source.kql"
                }
              ]
            },
            {
              "captures": {
                "2": {
                  "name": "variable.other.property.tide"
                },
                "3": {
                  "name": "meta.embedded.block.kql",
                  "patterns": [
                    {
                      "include": "source.kql"
                    }
                  ]
                }
              },
              "match": "^(\\s+)(query)\\s*:\\s+(?![|>])(.+)$"
            },
            {
              "include": "$self"
            }
          ]
        },
        {
