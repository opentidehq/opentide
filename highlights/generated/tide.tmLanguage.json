{
  "name": "OpenTide opentide-yaml",
  "opentideHighlightSpec": "0.2.0",
  "patterns": [
    {
      "comment": "capture:comment",
      "match": "(?m)^\\s*#.*$",
      "name": "comment.line.opentide"
    },
    {
      "comment": "capture:string",
      "match": "\"(\\\\.|[^\"\\\\])*\"|'(\\\\.|[^'\\\\])*'",
      "name": "string.quoted.opentide"
    },
    {
      "comment": "capture:number",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.opentide"
    },
    {
      "comment": "capture:tide.keyword",
      "match": "(?m)^\\s*(?:carbon_black_cloud|composition|configurations|criticality|crowdstrike|defender_for_endpoint|description|detection_model|file|harfanglab|metadata|name|objective|platforms|procedure|references|response|sentinel|sentinel_one|severity|splunk|status|techniques|threat)\\s*:",
      "name": "keyword.control.tide"
    },
    {
      "comment": "capture:tide.property",
      "match": "(?m)^\\s*(?:actors|alert|alert_severity|analysis|att\\&ck|author|availability|category|chaining|containment|contributors|created|cron_schedule|data|device|enabled|entities|event|frequency|grouping|impact|impacted_entities|internal|leverage|lookback|methodology|modified|organisation|priority|public|purpose|query|recommendation|relation|reports|requirements|scheduling|schema|scope|search|searches|selection|signals|strategy|suppression|surface|system|terrain|threats|title|tlp|type|uuid|vector|version|viability)\\s*:",
      "name": "variable.other.property.tide"
    },
    {
      "comment": "capture:markdown.heading",
      "match": "(?m)^\\s*#{1,6}\\s+.*$",
      "name": "markup.heading.markdown.tide"
    },
    {
      "comment": "capture:markdown.code",
      "match": "`[^`]+`",
      "name": "markup.inline.raw.markdown.tide"
    },
    {
      "comment": "capture:markdown.list",
      "match": "(?m)^\\s*(?:[-*+]|\\d+\\.)\\s+",
      "name": "punctuation.definition.list.markdown.tide"
    },
    {
      "comment": "capture:tide.uuid",
      "match": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}",
      "name": "constant.other.uuid.tide"
    },
    {
      "comment": "capture:tide.schema",
      "match": "\\b[A-Za-z][A-Za-z0-9_]*::[0-9.]+",
      "name": "entity.name.type.schema.tide"
    },
    {
      "comment": "capture:boolean",
      "match": "(?<![A-Za-z0-9_])(?:true|false)(?![A-Za-z0-9_])",
      "name": "constant.language.boolean.opentide"
    }
  ],
  "scopeName": "source.opentide-yaml"
}