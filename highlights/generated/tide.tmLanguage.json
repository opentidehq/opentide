    },
    {
      "comment": "capture:markdown.code",
      "match": "`[^`]+`",
      "name": "markup.inline.raw.markdown.tide"
    },
    {
      "comment": "capture:markdown.list",
      "match": "(?m)^\\s*(?:[-*+]|\\d+\\.)\\s+",
      "name": "punctuation.definition.list.markdown.tide"
    },
    {
      "comment": "capture:tide.uuid",
      "match": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}",
      "name": "constant.other.uuid.tide"
    },
    {
      "comment": "capture:tide.schema",
      "match": "\\b[A-Za-z][A-Za-z0-9_]*::[0-9.]+",
      "name": "entity.name.type.schema.tide"
    },
    {
      "comment": "capture:boolean",
      "match": "(?<![A-Za-z0-9_])(?:true|false)(?![A-Za-z0-9_])",
      "name": "constant.language.boolean.opentide"
