{
  "name": "OpenTide opentide-yaml",
  "opentideHighlightSpec": "0.2.0",
  "patterns": [
    {
      "comment": "capture:comment",
      "match": "(?m)^\\s*#.*$",
      "name": "comment.line.opentide"
    },
    {
      "comment": "capture:string",
      "match": "\"(\\\\.|[^\"\\\\])*\"|'(\\\\.|[^'\\\\])*'",
      "name": "string.quoted.opentide"
    },
    {
      "comment": "capture:number",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.opentide"
    },
    {
      "comment": "capture:tide.property",
      "match": "(?m)^\\s*(?:action|actions|actors|advanced|alert|alert_severity|allow_block|analysis|arch|att\\&ck|attack|author|availability|bcc|carbon_black_cloud|category|cc|chaining|classification|collect_investigation_package|column|comparator|composition|condition|confidence|configurations|containment|content_type|context|contributors|cool_off|correlation|correlation_search|create_incident|created|criticality|cron|cron_schedule|crowdstrike|custom_condition|custom_details|custom_time|cve|data|defender_for_endpoint|description|details|detection_model|detectors|device|device_groups|devices|disable_user|drilldown|duration|dynamic_properties|earliest|effort|email|enabled|end|entities|entity|event|examples|exclusions|expiration|expires|false_positives|field|fields|file|files|flags|force_password_reset|frequency|group_by_alert_details|group_by_custom_details|group_by_entities|group_name|grouping|grouping_lookback|groups|harfanglab|identifier|impact|impacted_entities|imports|include|initiate_investigation|inline_results|internal|investment|isolate_device|key|killchain|language|latest|let|leverage|link|logsource|logsources|lookback|mailbox|mappings|mark_as_compromised|match_in_order|matches_required|matching|maturity|message|meta|metadata|methodology|modified|modifiers|name|network_quarantine|notable|nrt|objective|operator|organisation|organizations|os|outcome|parent|platforms|playbook|priority|procedure|product|property|public|purpose|quarantine_file|query|reason|recommendation|references|reopen_closed_incidents|report|reports|requirements|responders|response|restrict_app_execution|results_link|risk|risk_objects|rule_id|rule_id_bundle|run_antivirus_scan|schedule|scheduling|schema|scope|score|search|search_string|searches|security_domain|selection|selections|send_csv|send_pdf|sentinel|sentinel_one|severity|sighting|sigma|signals|single_event|splunk|start|status|strategy|strings|sub_queries|subject|suppression|surface|system|tactic|tactics|tags|technique|techniques|technology|template|tenant|tenants|terrain|threat|threat_objects|threats|threshold|throttling|time_window|timerange|title|tlp|to|treat_as_threat|trigger|trigger_condition|trigger_time|type|user|users|uuid|value|version|viability|watchlist|yara)\\s*:",
      "name": "variable.other.property.tide"
    },
    {
      "comment": "capture:markdown.heading",
      "match": "(?m)^\\s*#{1,6}\\s+.*$",
      "name": "markup.heading.markdown.tide"
    },
    {
      "comment": "capture:markdown.code",
      "match": "`[^`]+`",
      "name": "markup.inline.raw.markdown.tide"
    },
    {
      "comment": "capture:markdown.list",
      "match": "(?m)^\\s*(?:[-*+]|\\d+\\.)\\s+",
      "name": "punctuation.definition.list.markdown.tide"
    },
    {
      "comment": "capture:tide.uuid",
      "match": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}",
      "name": "constant.other.uuid.tide"
    },
    {
      "comment": "capture:tide.schema",
      "match": "\\b[A-Za-z][A-Za-z0-9_]*::[0-9.]+",
      "name": "entity.name.type.schema.tide"
    },
    {
      "comment": "capture:boolean",
      "match": "(?<![A-Za-z0-9_])(?:true|false)(?![A-Za-z0-9_])",
      "name": "constant.language.boolean.opentide"
    }
  ],
  "scopeName": "source.opentide-yaml"
}