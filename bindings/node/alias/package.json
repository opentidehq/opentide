{
  "name": "opentide",
  "version": "0.0.0",
  "description": "An alias of @opentide/opentide, the opentide SDK and command line for Node.js, so that `npx opentide` works.",
  "license": "EUPL-1.2",
  "homepage": "https://opentide.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opentidehq/opentide.git",
    "directory": "bindings/node/alias"
  },
